# ─────────────────────────────────────────────────────────────
# Environment variables — Phase 2 integrations
# Copy to .env locally (gitignored). In production these live in
# GitHub Actions secrets and/or hosting env vars (Netlify, Amplify).
# NO value in this file, ever. See INTEGRATIONS.md / STRIPE_SETUP.md.
# ─────────────────────────────────────────────────────────────

# Stripe — only needed for webhook verification (server routes).
# Payment Links require NO keys at all — that's why we use them.
# Publishable Key (pk_live_... / pk_test_...) goes in site.js, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printify — used at BUILD TIME only (catalog fetch in CI).
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# HubSpot — only needed if a server-side Private App is added.
# The Forms Submission API used by HubSpotForm.astro needs NO token.
# Portal ID goes in site.js → integrations.hubspotPortalId, not here.
HUBSPOT_PRIVATE_APP_TOKEN=

# Google Analytics 4 — Measurement ID is PUBLIC (not a secret).
# Set it in src/config/site.js → integrations.ga4Id instead.
# Only add here if you need it at build time for server-side rendering.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
