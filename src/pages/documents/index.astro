---
/**
 * Documents / Transparency page — annual reports, Form 990, audit reports,
 * press kit. ComplianceBadge + GA4 download tracking via DocumentsGrid.
 * Template: replace placeholder doc hrefs with real PDF paths in /public/documents/.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import DocumentsGrid from '../../components/DocumentsGrid.astro';
import ComplianceBadge from '../../components/ComplianceBadge.astro';
import { SITE } from '../../config/site.js';

const docs = [
  // Annual Reports
  {
    title: '2024 Annual Report',
    description: 'Full impact report for fiscal year 2024, including program outcomes and financials.',
    href: '/documents/annual-report-2024.pdf',
    year: '2024',
    type: 'annual-report' as const,
    fileSize: '2.1 MB',
  },
  {
    title: '2023 Annual Report',
    description: 'Impact and financial summary for fiscal year 2023.',
    href: '/documents/annual-report-2023.pdf',
    year: '2023',
    type: 'annual-report' as const,
    fileSize: '1.8 MB',
  },
  // Form 990
  {
    title: 'Form 990 (2023)',
    description: 'IRS Form 990 for tax year 2023, filed with the IRS.',
    href: '/documents/form-990-2023.pdf',
    year: '2023',
    type: '990' as const,
    fileSize: '890 KB',
  },
  {
    title: 'Form 990 (2022)',
    description: 'IRS Form 990 for tax year 2022.',
    href: '/documents/form-990-2022.pdf',
    year: '2022',
    type: '990' as const,
    fileSize: '750 KB',
  },
  // Audits
  {
    title: 'Audited Financial Statements (2023)',
    description: 'Independent auditor report and financial statements for fiscal year 2023.',
    href: '/documents/audit-2023.pdf',
    year: '2023',
    type: 'audit' as const,
    fileSize: '1.2 MB',
  },
  // Press Kit
  {
    title: 'Press Kit',
    description: 'Logo files, organizational fact sheet, photos, and boilerplate for media use.',
    href: '/documents/press-kit.zip',
    type: 'press-kit' as const,
    fileSize: '12 MB',
  },
];
---

<BaseLayout
  title="Documents & Transparency"
  description={`Financial transparency for ${(SITE as any).legalName ?? SITE.name}. Download annual reports, Form 990, audit reports, and press materials.`}
>
  <Hero
    eyebrow="Full Transparency"
    heading="Our Commitment to Openness"
    body="We believe donors deserve to see exactly how their money is used. All financial documents are available here for download at any time."
    variant="teal"
  />

  <!-- 501(c)(3) badge -->
  <section class="band" aria-labelledby="compliance-heading">
    <div class="container">
      <p class="eyebrow">Our Status</p>
      <h2 id="compliance-heading">Verified Nonprofit</h2>
      <div class="compliance-layout">
        <ComplianceBadge
          ein={(SITE as any).ein}
          charityNavigatorUrl={(SITE as any).charityNavigatorUrl}
          candidUrl={(SITE as any).candidUrl}
        />
        <div class="compliance-text">
          <p class="prose">
            {(SITE as any).legalName ?? SITE.name} is a 501(c)(3) nonprofit public charity
            recognized by the IRS. All donations are tax-deductible to the fullest extent
            permitted by law.
          </p>
          <p class="prose">
            We are committed to financial transparency. Our Form 990 filings, audited financial
            statements, and annual reports are published below for public review.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Document grid -->
  <div class="band band--teal">
    <div class="container">
      <DocumentsGrid
        heading="Financial Documents"
        docs={docs}
        showFilters={true}
      />
    </div>
  </div>

  <!-- Request section -->
  <section class="band" aria-labelledby="request-heading">
    <div class="container container--narrow">
      <h2 id="request-heading">Need Something Else?</h2>
      <p class="prose">
        If you need a document not listed here, such as prior-year filings, a donor acknowledgment letter,
        or detailed program financials, please contact us and we will respond within three business days.
      </p>
      <a class="btn btn--primary" href="/contact/">Contact Us</a>
    </div>
  </section>
</BaseLayout>

<style>
  .compliance-layout {
    display: grid;
    gap: var(--space-l);
    align-items: start;
    margin-top: var(--space-m);
  }
  @media (min-width: 52rem) { .compliance-layout { grid-template-columns: auto 1fr; } }
  .compliance-text > * + * { margin-top: var(--space-s); }
</style>
