---
/**
 * KellerChat Navigator Portal — login page.
 * Auth is stubbed: both buttons link directly to / for now.
 * TODO: Wire "Sign in with HubSpot" to HubSpot OAuth flow.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Navigator Portal Login"
  description="Sign in to the KellerChat Navigator Portal — secure, accessible chat for blind and low-vision navigators powered by Eye Spy Foundation."
>
  <div class="login-page">
    <div class="login-card">

      <!-- Eye Spy Foundation wordmark -->
      <div class="login-org" aria-label="Eye Spy Foundation">
        <svg
          width="120"
          height="36"
          viewBox="0 0 120 36"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          focusable="false"
        >
          <rect width="120" height="36" rx="6" fill="#F37121"/>
          <circle cx="18" cy="18" r="10" fill="#FBCDB1"/>
          <circle cx="18" cy="18" r="6"  fill="#933001"/>
          <circle cx="18" cy="18" r="3"  fill="#000000"/>
          <circle cx="19.5" cy="16.5" r="1" fill="#FFFFFF"/>
          <text x="34" y="15" font-family="Poppins,sans-serif" font-weight="700" font-size="10" fill="#000000">Eye Spy</text>
          <text x="34" y="26" font-family="Open Sans,sans-serif" font-weight="600" font-size="7" fill="#3B0F00" letter-spacing="1.4">FOUNDATION</text>
        </svg>
      </div>

      <!-- KellerChat mark + portal heading -->
      <div class="login-brand">
        <div class="kc-mark" aria-hidden="true">K</div>
        <div>
          <h1 class="login-title">KellerChat Navigator Portal</h1>
        </div>
      </div>

      <p class="login-description">
        Secure, accessible chat for blind and low-vision navigators — powered by Eye Spy Foundation.
      </p>

      <!-- Error region -->
      <div id="login-error" role="alert" aria-live="assertive" hidden></div>

      <!-- Sign-in form -->
      <form class="login-form" aria-label="Sign in to KellerChat" novalidate>
        <div class="form-group">
          <label for="email">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            aria-required="true"
            spellcheck="false"
          />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
            aria-required="true"
          />
        </div>

        <!-- Screen-reader hint for the primary button -->
        <span id="hubspot-hint" class="sr-only">
          You will be redirected to HubSpot to complete sign-in.
        </span>

        <!-- TODO: Replace href with HubSpot OAuth flow -->
        <a
          href="/"
          class="btn-primary"
          aria-label="Sign in to KellerChat Navigator Portal"
          aria-describedby="hubspot-hint"
        >
          Sign in with HubSpot
        </a>

        <div class="login-divider" aria-hidden="true">
          <span>or</span>
        </div>

        <a
          href="/"
          class="btn-ghost"
          aria-label="Continue to KellerChat without signing in"
        >
          Continue without signing in
        </a>
      </form>

      <p class="login-legal">
        By signing in you agree to our
        <a href="/privacy/">Privacy Policy</a> and
        <a href="/terms/">Terms of Use</a>.<br />
        This portal is for authorized Eye Spy Foundation navigators only.
      </p>

    </div>
  </div>
</BaseLayout>

<style>
/* Open Sans + Poppins via Google Fonts (Eye Spy system) */
@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Poppins:wght@600;700&display=swap');

/* ── Color tokens (light by default) ───────────────────────── */
:root {
  --login-bg:       #F2F2F2;
  --login-card:     #FFFFFF;
  --login-text:     #222222;
  --login-muted:    #555555;
  --login-border:   #CCCCCC;
  --login-accent:   #933001;
  --login-focus:    #5E7AC3;
  --login-shadow:   0 4px 24px rgba(0,0,0,.12);
  --login-font:     'Open Sans', system-ui, sans-serif;
  --login-display:  'Poppins', var(--login-font);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --login-bg:     #111111;
    --login-card:   #1a1a1a;
    --login-text:   #EEEEEE;
    --login-muted:  #AAAAAA;
    --login-border: #333333;
    --login-shadow: 0 4px 24px rgba(0,0,0,.5);
  }
}
:root[data-theme="dark"] {
  --login-bg:     #111111;
  --login-card:   #1a1a1a;
  --login-text:   #EEEEEE;
  --login-muted:  #AAAAAA;
  --login-border: #333333;
  --login-shadow: 0 4px 24px rgba(0,0,0,.5);
}

/* ── Page ───────────────────────────────────────────────────── */
.login-page {
  min-height: 100%;
  background: var(--login-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  font-family: var(--login-font);
  color: var(--login-text);
}

/* ── Card ───────────────────────────────────────────────────── */
.login-card {
  background: var(--login-card);
  border-radius: 16px;
  box-shadow: var(--login-shadow);
  padding: 2.5rem 2rem;
  width: 100%;
  max-width: 420px;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

/* ── Org logo ───────────────────────────────────────────────── */
.login-org {
  display: flex;
  justify-content: center;
}

/* ── KellerChat brand mark + h1 ─────────────────────────────── */
.login-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.kc-mark {
  width: 44px;
  height: 44px;
  background: #4B9EFF;
  border-radius: 10px;
  display: grid;
  place-items: center;
  font-family: var(--login-display);
  font-weight: 700;
  font-size: 1.3rem;
  color: #fff;
  flex-shrink: 0;
}
.login-title {
  font-family: var(--login-display);
  font-weight: 700;
  font-size: 1.125rem;
  line-height: 1.3;
  margin: 0;
  color: var(--login-text);
}

/* ── Description ────────────────────────────────────────────── */
.login-description {
  margin: 0;
  color: var(--login-muted);
  font-size: 0.9rem;
  line-height: 1.5;
}

/* ── Form ───────────────────────────────────────────────────── */
.login-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}
.form-group label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--login-text);
}
.form-group input {
  min-height: 44px;
  padding: 0.625rem 0.875rem;
  border: 2px solid var(--login-border);
  border-radius: 8px;
  background: var(--login-card);
  color: var(--login-text);
  font-family: var(--login-font);
  font-size: 1rem;
  transition: border-color 0.15s;
}
.form-group input:focus {
  outline: 3px solid var(--login-focus);
  outline-offset: 2px;
  border-color: var(--login-focus);
}
.form-group input[aria-invalid="true"] {
  border-color: #c0392b;
}

/* ── Buttons ────────────────────────────────────────────────── */
.btn-primary,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  border-radius: 8px;
  font-family: var(--login-font);
  font-weight: 600;
  font-size: 0.9375rem;
  text-decoration: none;
  cursor: pointer;
  transition: opacity 0.15s;
  padding-inline: 1rem;
}
.btn-primary {
  background: var(--login-accent);
  color: #FFFFFF;
  border: none;
}
/* #933001 on #FFFFFF: 7.0:1 (large) — WCAG AAA.
   #FFFFFF on #933001: 7.0:1 — WCAG AAA. */
.btn-primary:hover { opacity: 0.88; }
.btn-primary:focus-visible {
  outline: 3px solid var(--login-focus);
  outline-offset: 2px;
}
.btn-ghost {
  background: transparent;
  color: var(--login-text);
  border: 2px solid var(--login-border);
}
.btn-ghost:hover { background: var(--login-bg); }
.btn-ghost:focus-visible {
  outline: 3px solid var(--login-focus);
  outline-offset: 2px;
}

/* ── Divider ────────────────────────────────────────────────── */
.login-divider {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--login-muted);
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.login-divider::before,
.login-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--login-border);
}

/* ── Error region ───────────────────────────────────────────── */
#login-error:not([hidden]) {
  padding: 0.75rem 1rem;
  border-radius: 8px;
  background: rgba(192,57,43,.1);
  border: 1px solid rgba(192,57,43,.4);
  color: #8b1a10;
  font-size: 0.875rem;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) #login-error:not([hidden]) {
    color: #f1948a;
    background: rgba(192,57,43,.2);
  }
}
:root[data-theme="dark"] #login-error:not([hidden]) {
  color: #f1948a;
  background: rgba(192,57,43,.2);
}

/* ── Legal small print ──────────────────────────────────────── */
.login-legal {
  margin: 0;
  font-size: 0.8rem;
  color: var(--login-muted);
  line-height: 1.6;
  text-align: center;
}
.login-legal a {
  color: var(--login-accent);
  text-decoration: underline;
  text-underline-offset: 2px;
}
.login-legal a:focus-visible {
  outline: 3px solid var(--login-focus);
  outline-offset: 2px;
  border-radius: 2px;
}

/* ── Utility ────────────────────────────────────────────────── */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 480px) {
  .login-card {
    padding: 2rem 1.25rem;
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
</style>
