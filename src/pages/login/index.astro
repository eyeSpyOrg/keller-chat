---
/**
 * KellerChat Navigator Portal — login page.
 * OAuth only: HubSpot or Google. Both stub to / for now.
 * chatMode hides site Header/Footer from layout and assistive tech.
 * TODO: Wire buttons to real OAuth flows.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Navigator Portal Login"
  description="Sign in to the KellerChat Navigator Portal — secure, accessible chat for blind and low-vision navigators powered by Eye Spy Foundation."
  chatMode={true}
>
  <div class="login-page">
    <div class="login-card">

      <!-- KellerChat identity -->
      <div class="login-brand">
        <img src="/kc-logo-mark.png" alt="" class="kc-mark-img" aria-hidden="true" width="64" height="64">
        <div>
          <h1 class="login-title">Keller Chat</h1>
          <p class="login-sub">Keller<span class="login-sub-sep" aria-hidden="true"> · </span><span class="login-sub-chat">Chat</span><span class="login-sub-org"> · Eye Spy Foundation</span></p>
        </div>
      </div>

      <!-- Error region -->
      <div id="login-error" role="alert" aria-live="assertive" hidden></div>

      <!-- OAuth options -->
      <div class="login-actions" role="group" aria-label="Sign-in options">

        <!-- TODO: Replace href with HubSpot OAuth flow -->
        <a
          href="/"
          class="btn-oauth btn-hubspot"
          aria-label="Sign in to KellerChat with HubSpot"
          aria-describedby="hubspot-hint"
        >
          <svg width="22" height="22" viewBox="0 0 512 512" fill="none" aria-hidden="true" focusable="false">
            <path d="M323.3 138.7V99.4a38.9 38.9 0 1 0-31.2 0v39.3a111 111 0 0 0-51 24.3L136.4 82.4a43.5 43.5 0 1 0-18.8 25.6l103.2 79.7a111 111 0 0 0 0 136.6L117.6 404a43.4 43.4 0 1 0 18.9 25.5l103.2-80.6a111 111 0 0 0 160.7-99c0-47.8-30.1-89-72.1-105.2Zm-67.3 158a63.2 63.2 0 1 1 0-126.4 63.2 63.2 0 0 1 0 126.4Z" fill="currentColor"/>
          </svg>
          Sign in with HubSpot
        </a>
        <span id="hubspot-hint" class="sr-only">
          You will be redirected to HubSpot to complete sign-in.
        </span>

        <!-- TODO: Replace href with Google OAuth flow -->
        <a
          href="/"
          class="btn-oauth btn-google"
          aria-label="Sign in to KellerChat with Google"
          aria-describedby="google-hint"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Sign in with Google
        </a>
        <span id="google-hint" class="sr-only">
          You will be redirected to Google to complete sign-in.
        </span>

      </div>

      <div class="login-divider" aria-hidden="true"><span>or</span></div>

      <a href="/" class="btn-skip" aria-label="Continue to KellerChat without signing in">
        Continue without signing in
      </a>

      <p class="login-legal">
        Authorized Eye Spy Foundation navigators only.
      </p>

    </div>
  </div>
</BaseLayout>

<style>
/* Open Sans + Poppins (self-hosted via global.css) */

/* ── Hide site chrome — login is a standalone surface ──────── */
:global(body) { background: #000000 !important; }
:global(body > .site-header),
:global(body > .site-footer) { display: none !important; }
:global(#main-content) { padding: 0 !important; }

.login-page {
  min-height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  font-family: 'Open Sans', system-ui, sans-serif;
}

/* ── Card ───────────────────────────────────────────────────── */
.login-card {
  background: #ffffff;
  border: 1px solid #e0e0e0;
  border-radius: 20px;
  box-shadow: 0 8px 48px rgba(0,0,0,.35);
  padding: 2.5rem 2rem;
  width: 100%;
  max-width: 400px;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

/* ── Brand ──────────────────────────────────────────────────── */
.login-brand {
  display: flex;
  align-items: center;
  gap: 0.875rem;
}
.kc-mark-img {
  width: 64px;
  height: 64px;
  object-fit: contain;
  flex-shrink: 0;
}
.login-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-weight: 700;
  font-size: 1.25rem;
  line-height: 1.2;
  margin: 0;
  color: #111111;
}
.login-sub {
  font-size: 0.8rem;
  color: #666666;
  margin: 0.125rem 0 0;
  font-weight: 600;
  letter-spacing: 0.02em;
}
/* "Chat" in Burnt Orange — passes 4.5:1 on white */
.login-sub-chat { color: #933001; }
.login-sub-sep  { color: #767676; font-weight: 300; }
.login-sub-org  { color: #767676; }

/* ── Description ────────────────────────────────────────────── */
.login-description {
  margin: 0;
  color: #aaaaaa;
  font-size: 0.9375rem;
  line-height: 1.5;
}

/* ── OAuth buttons ──────────────────────────────────────────── */
.login-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.btn-oauth {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.625rem;
  min-height: 56px;
  border-radius: 10px;
  font-family: 'Open Sans', system-ui, sans-serif;
  font-weight: 700;
  font-size: 1rem;
  text-decoration: none;
  cursor: pointer;
  transition: opacity 0.15s, box-shadow 0.15s;
  padding-inline: 1.25rem;
}
.btn-oauth:hover { opacity: 0.9; }
.btn-oauth:focus-visible {
  outline: 3px solid #5E7AC3;
  outline-offset: 3px;
  border-radius: 12px;
}

/* HubSpot — Burned Orange #933001, white text: 7.0:1 AAA */
.btn-hubspot {
  background: #933001;
  color: #ffffff;
  border: none;
  box-shadow: 0 2px 12px rgba(147,48,1,.4);
}
.btn-hubspot:hover { box-shadow: 0 4px 20px rgba(147,48,1,.6); }

/* Google — white bg, dark text for brand authenticity */
.btn-google {
  background: #ffffff;
  color: #111111;
  border: none;
}
.btn-google:hover { background: #f0f0f0; }

/* ── Divider ────────────────────────────────────────────────── */
.login-divider {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: #767676;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.login-divider::before,
.login-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #e0e0e0;
}

/* ── Skip link ──────────────────────────────────────────────── */
.btn-skip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  border-radius: 10px;
  font-family: 'Open Sans', system-ui, sans-serif;
  font-weight: 600;
  font-size: 0.9375rem;
  color: #666666;
  text-decoration: none;
  border: 1px solid #e0e0e0;
  background: transparent;
  transition: border-color 0.15s, color 0.15s;
  padding-inline: 1.25rem;
}
.btn-skip:hover {
  border-color: #aaaaaa;
  color: #111111;
}
.btn-skip:focus-visible {
  outline: 3px solid #5E7AC3;
  outline-offset: 3px;
  border-radius: 12px;
}

/* ── Error region ───────────────────────────────────────────── */
#login-error:not([hidden]) {
  padding: 0.75rem 1rem;
  border-radius: 8px;
  background: rgba(192,57,43,.15);
  border: 1px solid rgba(192,57,43,.5);
  color: #f1948a;
  font-size: 0.875rem;
}

/* ── Legal ──────────────────────────────────────────────────── */
.login-legal {
  margin: 0;
  font-size: 0.78rem;
  color: #767676;
  line-height: 1.6;
  text-align: center;
}
.login-legal a {
  color: #555555;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.login-legal a:hover { color: #111111; }
.login-legal a:focus-visible {
  outline: 3px solid #5E7AC3;
  outline-offset: 2px;
  border-radius: 2px;
}

/* ── Utility ────────────────────────────────────────────────── */
.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 480px) {
  .login-card { padding: 2rem 1.25rem; border-radius: 16px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
</style>
