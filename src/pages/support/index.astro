---
/**
 * Support / Donate page — impact stories, donation form, tiers, FAQ.
 * Voice: ESF brand (02_VOICE_TONE_AND_GUARDRAILS.md):
 *   human, clear, warm without being sentimental, grade 8.
 * CTAs: "Support accessible navigation" not "donate now" cold ask.
 * Guardrails: no "BVI", no "visually impaired", no fabricated statistics.
 * Testimonials: clearly placeholder examples — replace with real voices.
 *
 * DonationForm uses Stripe Payment Links (Stripe-hosted checkout).
 * No custom card form — complies with CLAUDE.md security policy.
 * Replace paymentLinks URLs with real Stripe Payment Links. See STRIPE_SETUP.md.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import DonationForm from '../../components/DonationForm.astro';
import ImpactMetrics from '../../components/ImpactMetrics.astro';
import Testimonial from '../../components/Testimonial.astro';
import VideoGallery from '../../components/VideoGallery.astro';
import ComplianceBadge from '../../components/ComplianceBadge.astro';
import FAQ from '../../components/FAQ.astro';
import { SITE } from '../../config/site.js';

// Replace with real Stripe Payment Link URLs from your Stripe Dashboard.
// Test links use https://buy.stripe.com/test_... format.
// See STRIPE_SETUP.md for step-by-step instructions.
const paymentLinks = {
  25:  'https://buy.stripe.com/test_REPLACE_25',
  50:  'https://buy.stripe.com/test_REPLACE_50',
  100: 'https://buy.stripe.com/test_REPLACE_100',
  250: 'https://buy.stripe.com/test_REPLACE_250',
  custom: 'https://buy.stripe.com/test_REPLACE_CUSTOM',
};

// Impact statements that update dynamically when a donor picks an amount.
const impactMap = {
  25:  'helps cover one month of assistive technology coaching for a community member',
  50:  'funds a full resource navigation session — one person, real answers',
  100: 'supports a free community workshop open to everyone who needs it',
  250: 'covers one month of peer mentorship coordination',
};

const metrics = [
  { number: '$50', label: 'funds a navigation session', icon: '🧭' },
  { number: '$100', label: 'runs a community workshop', icon: '📚' },
  { number: '$250', label: 'a month of peer mentorship', icon: '🤝' },
  { number: '100%', label: 'of gifts support programs', icon: '💚' },
];

const donationFaqs = [
  {
    question: 'Is my donation tax-deductible?',
    answer: `Yes. Eye Spy Foundation is a registered 501(c)(3) nonprofit organization (EIN: [PLACEHOLDER]). Your donation is tax-deductible to the fullest extent permitted by law. You will receive a receipt email with tax documentation.`,
  },
  {
    question: 'How is my donation used?',
    answer: 'Every donation funds our core mission: navigation support, community events, and resource curation. We maintain a high program spending ratio so your gift stays close to the community.',
  },
  {
    question: 'Can I donate monthly?',
    answer: "Yes. Select the 'Monthly' toggle before donating to become a monthly supporter. You can cancel anytime with no penalties through the Stripe customer portal linked in your receipt email.",
  },
  {
    question: 'What if I have questions about my donation?',
    answer: `Email us at ${SITE.email} or call [PLACEHOLDER]. We are happy to discuss how your gift supports our mission.`,
  },
  {
    question: 'Do you accept other payment methods?',
    answer: 'We accept all major credit cards, Apple Pay, Google Pay, and PayPal through our secure Stripe payment processor.',
  },
];

// PLACEHOLDER testimonials — replace with real voices from the community
// before launch. Per brand guardrails, attributed quotes require human approval.
const testimonials = [
  {
    quote: "I didn't know where to start. The navigation team found five programs for me in one conversation. I had been searching alone for two years.",
    name: '[Community member name]',
    attribution: 'Navigation program participant',
  },
  {
    quote: "Giving here feels different. You can see exactly what happens with your money. That matters to me.",
    name: '[Donor name]',
    attribution: 'Monthly donor',
  },
  {
    quote: "My mentor had been through exactly what I was going through. That's not something you can fake.",
    name: '[Participant name]',
    attribution: 'Peer mentorship participant',
  },
];

const videos: { videoId: string; title: string; description?: string }[] = [
  // Add real YouTube video IDs here once impact videos are uploaded.
  // Example: { videoId: 'YOUR_ID', title: 'One Year. Real People. Real Change.' }
];
---

<BaseLayout
  title="Support Eye Spy Foundation"
  description="Your gift funds free navigation support, workshops, and peer mentorship for the blind and low vision community. 100% of donations support programs. Give today."
>
  <!-- Hero -->
  <Hero
    eyebrow="Make an Impact"
    heading="Help People Navigate. Discover. Find. Connect."
    body="The blind and low vision community deserves a world with less friction. Your gift funds the people, programs, and platform that make that possible — for free, for everyone."
    variant="teal"
  />

  <!-- Donation form + trust signals -->
  <section class="band" aria-labelledby="donate-heading">
    <div class="container donate-layout">
      <div class="donate-layout__form">
        <h2 id="donate-heading" class="sr-only">Choose your gift amount</h2>
        <DonationForm
          amounts={[25, 50, 100, 250]}
          paymentLinks={paymentLinks}
          impactMap={impactMap}
          allowCustom={true}
          allowRecurring={true}
          taxMessage={true}
          heading="Choose Your Impact"
        />
      </div>
      <div class="donate-layout__trust">
        <ImpactMetrics metrics={metrics} heading="Where Your Gift Goes" />
        <ComplianceBadge />
      </div>
    </div>
  </section>

  <!-- Daily friction context — "why it matters" band -->
  <section class="band band--teal" aria-labelledby="why-heading">
    <div class="container container--narrow">
      <p class="eyebrow">Why It Matters</p>
      <h2 id="why-heading">A Working Phone Number Shouldn't Be a Luxury</h2>
      <p class="prose">
        Most resource websites for the blind and low vision community have listings
        that are out of date, phone numbers that go nowhere, and forms that don't
        work with screen readers. People in the middle of a real life crisis should
        not have to deal with that.
      </p>
      <p class="prose">
        We verify every listing by hand. We build every page to work with assistive
        technology. We answer the phone. That takes people — and people take funding.
      </p>
    </div>
  </section>

  <!-- Giving FAQ — placed before testimonials for credibility flow -->
  <div class="band">
    <div class="container container--narrow">
      <FAQ faqs={donationFaqs} heading="Giving FAQs" />
      <p class="prose faq-footer">
        More questions? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> —
        a real person will respond.
      </p>
    </div>
  </div>

  <!-- Impact videos when available -->
  {videos.length > 0 && (
    <div class="band">
      <div class="container">
        <VideoGallery
          eyebrow="In Their Own Words"
          heading="Real Stories From the Community"
          videos={videos}
          columns={2}
        />
      </div>
    </div>
  )}

  <!-- Community voices (placeholder — replace before launch) -->
  <section class="band band--gold" aria-labelledby="voices-heading">
    <div class="container">
      <p class="eyebrow">From the Community</p>
      <h2 id="voices-heading">What People Say</h2>
      <p class="prose section-intro">
        These are placeholder quotes. Replace with real voices from participants
        and donors before launch. Per brand guidelines, all attributed quotes require
        human review and approval.
      </p>
      <div class="testimonials-grid">
        {testimonials.map((t, i) => (
          <Testimonial {...t} variant={i === 0 ? 'featured' : 'default'} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .donate-layout { display: grid; gap: var(--space-l); align-items: start; }
  @media (min-width: 52rem) { .donate-layout { grid-template-columns: 1fr 1fr; } }
  .donate-layout__trust { display: flex; flex-direction: column; gap: var(--space-m); }

  .testimonials-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .testimonials-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .testimonials-grid { grid-template-columns: repeat(3, 1fr); } }

  .faq-footer { margin-top: var(--space-m); }
  .section-intro { max-width: 60ch; margin-bottom: var(--space-m); }
</style>
