---
/**
 * Contact — NAP renders only from site.js (never drifts from footer
 * or Organization schema). Inquiry form arrives with HubSpot in
 * Phase 2 via HubSpotForm.astro — never the embedded widget.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { SITE } from '../config/site.js';

const telDisplay = '(844) 222‑8848';

const contactFaqs = [
  {
    question: 'How can I volunteer with Eye Spy?',
    answer: "Email team@eyespy.org with 'Volunteer' in the subject line. We will send you information about current opportunities in navigation support, community events, and development.",
  },
  {
    question: 'Can I request resources for someone else?',
    answer: 'Yes. Our navigators can help you find resources for a loved one. Use the contact form or call us to get started.',
  },
  {
    question: "How do I stay updated on Eye Spy's work?",
    answer: 'Subscribe to our newsletter on the homepage or follow us on Instagram @eyespyorg and Facebook at Eye Spy Foundation.',
  },
  {
    question: 'Is there a way to partner with Eye Spy?',
    answer: "Absolutely. If you're an organization, healthcare provider, or community partner interested in collaboration, reach out via the contact form and we will discuss opportunities.",
  },
  {
    question: 'What if I have accessibility issues with this website?',
    answer: "We are committed to WCAG 2.2 AA accessibility. If you encounter any barriers, please email accessibility@eyespy.org with details and we will fix it quickly.",
  },
];
---

<BaseLayout
  title="Contact"
  description="Contact Eye Spy Foundation at team@eyespy.org or (844) 222-8848. We help the blind and low vision community navigate resources — we greet everyone with a hug or a handshake."
>
  <section class="band band--teal band--tight">
    <div class="container container--narrow">
      <div class="section-head">
        <p class="eyebrow">We'd Love to Hear From You</p>
        <h1>Say Hello</h1>
        <p class="prose lead">
          We greet everyone with a hug or a handshake. Email works too.
          Questions about programs, partnerships, or how to get involved?
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container container--narrow">
      <h2 class="sr-only">Ways to reach us</h2>
      <div class="grid grid--2">
        <a class="card card--accent card--link contact-card" href={`mailto:${SITE.email}`}>
          <span class="contact-card__icon" aria-hidden="true">✉️</span>
          <span class="contact-card__label">Email</span>
          <span class="contact-card__value">{SITE.email}</span>
        </a>
        <a class="card card--accent card--link contact-card" href={`tel:${SITE.telephone}`}>
          <span class="contact-card__icon" aria-hidden="true">📞</span>
          <span class="contact-card__label">Phone</span>
          <span class="contact-card__value">{telDisplay}</span>
        </a>
      </div>

      <div class="card find-us">
        <h3 class="find-us__h">Where to Find Us</h3>
        <p>
          Eye Spy Foundation is based in Jacksonville, Florida, serving Northeast
          Florida and expanding nationally. Our resource platform is available
          anywhere at <a href="https://eyespy.org">EyeSpy.org</a>.
        </p>
      </div>

      {/* TODO: inquiry form (name, email, message → team@eyespy.org) lands in
          Phase 2 with the HubSpot portal + form GUID, rendered through
          HubSpotForm.astro (see INTEGRATIONS.md §2). */}
      <p class="prose form-soon">
        <span aria-hidden="true">📝</span> A quick inquiry form is on its way.
        For now, email or call us. We respond within two business days.
      </p>
    </div>
  </section>

  <!-- Getting involved FAQ -->
  <section class="band band--gold">
    <div class="container container--narrow">
      <FAQ faqs={contactFaqs} heading="Common Questions" />
    </div>
  </section>
</BaseLayout>

<style>
  .lead { font-size: var(--step-1); color: var(--color-text-muted); }
  .contact-card {
    display: grid; gap: 0.35rem; text-decoration: none; color: var(--color-text);
  }
  .contact-card__icon { font-size: 2rem; line-height: 1; }
  .contact-card__label {
    font-family: var(--font-display); font-weight: 700; font-size: 0.8rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent);
  }
  .contact-card__value { font-size: var(--step-1); font-weight: 700; word-break: break-word; }
  .find-us { margin-top: var(--space-m); }
  .find-us__h { margin: 0 0 0.35rem; }
  .form-soon {
    margin-top: var(--space-m);
    color: var(--color-text-muted);
    background: var(--color-gold-tint);
    border-radius: var(--radius);
    padding: var(--space-s) var(--space-m);
  }
  :global(html[data-a11y-contrast='high']) .form-soon { background: var(--color-surface); border: 1px solid var(--color-border); }
</style>
