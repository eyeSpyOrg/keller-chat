---
/**
 * FAQ — Eye Spy Foundation organization FAQ.
 * Replace [PLACEHOLDER] answers with real content before launch.
 * The FAQ component generates both the visible accordion and FAQPage schema.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { SITE } from '../config/site.js';

const faqs = [
  {
    question: 'What is Eye Spy Foundation?',
    answer:
      'Eye Spy Foundation helps blind and low vision people navigate toward a more informed, connected, and confident life. We provide navigation support, community events, internships, and a curated resource directory at EyeSpy.org.',
  },
  {
    question: 'Who does Eye Spy serve?',
    answer:
      'We serve three audiences: people directly affected by blindness or low vision (30,000+ in Jacksonville), advocates and allies (60,000+), and professionals like doctors, therapists, and educators (10,000+).',
  },
  {
    question: 'Where is Eye Spy located?',
    answer:
      'Eye Spy Foundation is based in Jacksonville, Florida, serving Northeast Florida and expanding nationally.',
  },
  {
    question: 'Are your programs free?',
    answer:
      'Yes — always. Every program is free to the blind and low vision community. We are funded by donations, grants, and community partnerships so you never have to pay.',
  },
  {
    question: 'What is EyeSpy.org?',
    answer:
      'EyeSpy.org is our flagship resource platform — a centralized, human-curated directory bringing together programs, services, events, news, and media into one accessible place for the blind and low vision community.',
  },
  {
    question: 'How can I volunteer with Eye Spy?',
    answer:
      "Email team@eyespy.org with 'Volunteer' in the subject line. We will send you information about current opportunities in navigation support, community events, and development.",
  },
  {
    question: 'How is my donation used?',
    answer:
      'Every donation funds our core programs: navigation support, community events, and resource curation. Our financials are published on the Documents page.',
  },
  {
    question: 'Is my donation tax-deductible?',
    answer:
      'Yes. Eye Spy Foundation is a registered 501(c)(3) nonprofit. Donations are tax-deductible to the fullest extent permitted by law. You will receive a receipt after your gift.',
  },
  {
    question: 'How transparent is Eye Spy about finances?',
    answer:
      'Very. We publish annual reports, Form 990s, and audit reports on our Documents page. We are committed to full financial transparency.',
  },
  {
    question: 'Is this website accessible?',
    answer:
      'We build to WCAG 2.2 AA standards. Every page has skip links, semantic landmarks, keyboard navigation, and an on-page accessibility toolbar (bottom right) with high contrast, text size, dyslexia-friendly font, and more. If you encounter a barrier, email us and we will fix it.',
  },
];
---

<BaseLayout
  title="FAQ"
  description="Eye Spy Foundation FAQ: who we serve, how our programs work, how donations are used, and how to get involved with the blind and low vision community."
>
  <section class="band band--teal band--tight">
    <div class="container container--narrow">
      <div class="section-head">
        <p class="eyebrow">Good to Know</p>
        <h1>Frequently Asked Questions</h1>
        <p class="prose lead">
          Answers about Eye Spy Foundation, our programs, donations, and how to get involved.
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container container--narrow">
      <FAQ faqs={faqs} heading="Your questions, answered" />
      <div class="card faq-help">
        <span class="faq-help__icon" aria-hidden="true">💬</span>
        <p>
          Still have a question? Email
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. A real person
          will respond within two business days.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead { font-size: var(--step-1); color: var(--color-text-muted); }
  .faq-help {
    display: flex; gap: var(--space-s); align-items: center;
    margin-top: var(--space-l); background: var(--color-teal-tint);
  }
  .faq-help__icon { font-size: 2rem; line-height: 1; }
  .faq-help p { margin: 0; }
  :global(html[data-a11y-contrast='high']) .faq-help { background: var(--color-surface); }
</style>
