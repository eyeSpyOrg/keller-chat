---
/**
 * /modules/ — Component library for internal design review.
 * noindex: true — never appears in search results.
 * Edit modules here; they render with real ESF styles + tokens.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Card from '../../components/Card.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Testimonial from '../../components/Testimonial.astro';
import FAQ from '../../components/FAQ.astro';
import ImpactMetrics from '../../components/ImpactMetrics.astro';
import DonationForm from '../../components/DonationForm.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';

const SAMPLE_FAQS = [
  { question: 'Who does Eye Spy Foundation serve?', answer: 'We serve the blind and low vision community in Northeast Florida and beyond — as well as the allies, caregivers, and professionals who support them.' },
  { question: 'Are programs free?', answer: 'Yes. All navigation support and community programs are free to participants. We are funded entirely by donations and grants.' },
  { question: 'How do donations get used?', answer: 'Donations fund direct services: navigation consultations, community workshops, and the EyeSpy.org resource directory. [NEEDS HUMAN VERIFICATION: specific breakdown %]' },
];

const SAMPLE_METRICS = [
  { number: '40+', label: 'people connected', detail: 'to resources nationally', icon: '🧭' },
  { number: '20+', label: 'community members', detail: 'in Eye Spy Socials', icon: '🤝' },
  { number: '8', label: 'internship placements', detail: 'from leading universities', icon: '🎓' },
  { number: '2023', label: 'founded', detail: 'Jacksonville, FL', icon: '📍' },
];

const SAMPLE_FEATURES = [
  { icon: '🧭', heading: 'Navigation Support', body: 'One-on-one help locating resources and community support, tailored to each person\'s situation.', href: '/programs/' },
  { icon: '🤝', heading: 'Eye Spy Socials', body: 'Monthly gatherings that build real friendships for the blind and low vision community here.', href: '/programs/' },
  { icon: '🖥️', heading: 'EyeSpy.org Directory', body: 'A centralized, human-verified directory of accessibility resources across Northeast Florida.', href: 'https://eyespy.org' },
];
---

<BaseLayout
  title="Module Library"
  description="Internal component library for ESF website design review."
  noindex={true}
>

  <!-- ── Page header ── -->
  <div class="mod-page-header">
    <div class="mod-page-header__inner">
      <h1>Module Library</h1>
      <p>Internal review only — <code>noindex</code>. Edit <code>src/pages/modules/index.astro</code>.</p>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Typography
  ════════════════════════════════════════════════ -->
  <div class="mod-section">
    <div class="mod-meta">
      <h2 class="mod-name">Typography</h2>
      <p class="mod-desc">Poppins headings · Open Sans body · fluid type scale</p>
    </div>
    <div class="mod-demo mod-demo--pad">
      <p class="eyebrow">Eyebrow / kicker label</p>
      <p class="demo-type demo-type--h1">Heading 1 — Navigate. Discover.</p>
      <p class="demo-type demo-type--h2">Heading 2 — Find. Connect.</p>
      <p class="demo-type demo-type--h3">Heading 3 — Community &amp; Resources</p>
      <p class="lead demo-type--lead">Lead text — slightly larger body copy used in hero sections and section intros. Open Sans 400.</p>
      <p class="demo-type--body">Body text — the default font size used for paragraphs, descriptions, and form fields. <a href="#">Links are underlined</a> and use Burned Orange for perceivability.</p>
      <p class="demo-type--muted">Muted text — used for captions, metadata, and secondary information. Meets 4.5:1+ on white and Ghost Grey.</p>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Color Palette
  ════════════════════════════════════════════════ -->
  <div class="mod-section mod-section--alt">
    <div class="mod-meta">
      <h2 class="mod-name">Color Palette</h2>
      <p class="mod-desc">ESF brand colors with WCAG contrast ratios</p>
    </div>
    <div class="mod-demo mod-demo--pad">
      <div class="color-swatches">
        <div class="swatch"><div class="swatch__chip swatch__chip--white"></div><p class="swatch__name">White</p><p class="swatch__hex">#FFFFFF — page bg</p></div>
        <div class="swatch"><div class="swatch__chip swatch__chip--grey"></div><p class="swatch__name">Ghost Grey</p><p class="swatch__hex">#F2F2F2 — surface</p></div>
        <div class="swatch"><div class="swatch__chip swatch__chip--black"></div><p class="swatch__name">Shadow Black</p><p class="swatch__hex">#222222 — body text</p></div>
        <div class="swatch"><div class="swatch__chip swatch__chip--accent"></div><p class="swatch__name">Burned Orange</p><p class="swatch__hex">#A83A05 — links/accent</p><p class="swatch__ratio">5.9:1 on white ✓</p></div>
        <div class="swatch"><div class="swatch__chip swatch__chip--brand"></div><p class="swatch__name">Original Orange</p><p class="swatch__hex">#F37121 — fills only</p><p class="swatch__ratio">Never as text on light bg</p></div>
        <div class="swatch"><div class="swatch__chip swatch__chip--peach"></div><p class="swatch__name">Peach</p><p class="swatch__hex">#FBCDB1 — soft bands</p><p class="swatch__ratio">10.1:1 w/ Shadow Black ✓</p></div>
        <div class="swatch"><div class="swatch__chip swatch__chip--wink"></div><p class="swatch__name">Wink</p><p class="swatch__hex">#5E7AC3 — focus only</p><p class="swatch__ratio">3.88:1 on white (non-text) ✓</p></div>
        <div class="swatch"><div class="swatch__chip swatch__chip--border"></div><p class="swatch__name">Border</p><p class="swatch__hex">#767676</p><p class="swatch__ratio">4.54:1 on white ✓</p></div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Buttons
  ════════════════════════════════════════════════ -->
  <div class="mod-section">
    <div class="mod-meta">
      <h2 class="mod-name">Buttons</h2>
      <p class="mod-desc">All variants — check contrast on each background</p>
    </div>

    <div class="mod-variant-label">Light background</div>
    <div class="mod-demo mod-demo--pad mod-demo--row">
      <a href="#" class="btn btn--primary">Primary</a>
      <a href="#" class="btn btn--secondary">Secondary</a>
      <a href="#" class="btn btn--brand">Brand (Orange)</a>
      <a href="#" class="btn btn--primary btn--lg">Primary Large</a>
      <a href="#" class="btn btn--secondary btn--lg">Secondary Large</a>
    </div>

    <div class="mod-variant-label">Dark background</div>
    <div class="mod-demo mod-demo--tinted mod-demo--row mod-demo--dark">
      <a href="#" class="btn btn--onDark">On Dark</a>
      <a href="#" class="btn btn--onDark btn--lg">On Dark Large</a>
    </div>

    <div class="mod-variant-label">Brand (Original Orange) background</div>
    <div class="mod-demo mod-demo--tinted mod-demo--row mod-demo--brand">
      <a href="#" class="btn btn--onBrand">On Brand</a>
      <a href="#" class="btn btn--onBrand btn--lg">On Brand Large</a>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Hero
  ════════════════════════════════════════════════ -->
  <div class="mod-section mod-section--alt">
    <div class="mod-meta">
      <h2 class="mod-name">Hero</h2>
      <p class="mod-desc">Copy left, image right. Four variants + background image.</p>
    </div>

    <div class="mod-variant-label">Light — copy + right image</div>
    <div class="mod-demo">
      <Hero
        headingLevel="h2"
        eyebrow="Eye Spy Foundation"
        heading="Navigate. Discover. Find. Connect. (Light)"
        body="We use technology and community-driven support to help blind and low vision people navigate toward a more informed, connected, and confident life."
        primaryCta={{ label: 'Get Started', href: '/programs/' }}
        secondaryCta={{ label: 'Learn More', href: '/about/' }}
        variant="light"
      >
        <ImagePlaceholder slot="image" label="[Community photo]" ratio="3 / 2" policy="real" icon="📷" />
      </Hero>
    </div>

    <div class="mod-variant-label">Dark — copy only (no image)</div>
    <div class="mod-demo">
      <Hero
        headingLevel="h2"
        eyebrow="Eye Spy Foundation"
        heading="Navigate. Discover. Find. Connect. (Dark)"
        body="We use technology and community-driven support to help blind and low vision people navigate toward a more informed, connected, and confident life."
        primaryCta={{ label: 'Get Started', href: '/programs/' }}
        secondaryCta={{ label: 'Learn More', href: '/about/' }}
        variant="dark"
      />
    </div>

    <div class="mod-variant-label">Brand (Original Orange) — copy + right image</div>
    <div class="mod-demo">
      <Hero
        headingLevel="h2"
        eyebrow="Eye Spy Foundation"
        heading="Navigate. Discover. Find. Connect. (Brand)"
        body="We use technology and community-driven support to help blind and low vision people navigate toward a more informed, connected, and confident life."
        primaryCta={{ label: 'Get Started', href: '/programs/' }}
        secondaryCta={{ label: 'Learn More', href: '/about/' }}
        variant="brand"
      >
        <ImagePlaceholder slot="image" label="[Community photo]" ratio="3 / 2" policy="real" icon="📷" />
      </Hero>
    </div>

    <div class="mod-variant-label">Background image — full bleed with overlay</div>
    <div class="mod-demo">
      <!-- bgImage: replace with a real photo path before launch -->
      <Hero
        headingLevel="h2"
        eyebrow="Eye Spy Foundation"
        heading="Navigate. Discover. Find. Connect. (Background Image)"
        body="We use technology and community-driven support to help blind and low vision people navigate toward a more informed, connected, and confident life."
        primaryCta={{ label: 'Get Started', href: '/programs/' }}
        secondaryCta={{ label: 'Learn More', href: '/about/' }}
        bgImage="/og-default.jpg"
      />
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Cards
  ════════════════════════════════════════════════ -->
  <div class="mod-section">
    <div class="mod-meta">
      <h2 class="mod-name">Cards</h2>
      <p class="mod-desc">Default · Accent · with image</p>
    </div>

    <div class="mod-variant-label">Three-up grid</div>
    <div class="mod-demo mod-demo--pad">
      <div class="grid grid--3">
        <Card
          eyebrow="Program"
          heading="Navigation Support"
          body="One-on-one help locating resources, services, and community connections tailored to each person."
          ctaLabel="Learn more"
          ctaHref="/programs/"
          headingLevel="h3"
        />
        <Card
          eyebrow="Community"
          heading="Eye Spy Socials"
          body="Monthly gatherings that build real friendships for the blind and low vision community near you."
          ctaLabel="Join us"
          ctaHref="/programs/"
          accent={true}
          headingLevel="h3"
        />
        <Card
          eyebrow="Resource"
          heading="EyeSpy.org Directory"
          body="A human-curated directory of verified accessibility resources serving blind and low vision people."
          ctaLabel="Browse directory"
          ctaHref="https://eyespy.org"
          headingLevel="h3"
        />
      </div>
    </div>

    <div class="mod-variant-label">Two-up with images</div>
    <div class="mod-demo mod-demo--pad">
      <div class="grid grid--2">
        <Card
          imageAlt=""
          eyebrow="Annual Report"
          heading="2024 Impact Report"
          body="A full accounting of how we spent every dollar and who we served this year."
          ctaLabel="Read the report"
          ctaHref="/documents/"
          headingLevel="h3"
        />
        <Card
          imageAlt=""
          eyebrow="Newsletter"
          heading="Stay Connected"
          body="Monthly updates from Eye Spy Foundation covering new resources, events, and community stories."
          ctaLabel="Subscribe"
          ctaHref="/contact/"
          accent={true}
          headingLevel="h3"
        />
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Feature Grid
  ════════════════════════════════════════════════ -->
  <div class="mod-section mod-section--alt">
    <div class="mod-meta">
      <h2 class="mod-name">Feature Grid</h2>
      <p class="mod-desc">Icon + heading + body, 2- or 3-column</p>
    </div>

    <div class="mod-variant-label">3 columns — light</div>
    <div class="mod-demo mod-demo--pad">
      <FeatureGrid
        eyebrow="What We Do"
        features={SAMPLE_FEATURES}
        columns={3}
      />
    </div>

    <div class="mod-variant-label">3 columns — dark band</div>
    <div class="mod-demo mod-demo--tinted mod-demo--dark">
      <FeatureGrid
        eyebrow="What We Do"
        features={SAMPLE_FEATURES}
        columns={3}
      />
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Testimonials
  ════════════════════════════════════════════════ -->
  <div class="mod-section">
    <div class="mod-meta">
      <h2 class="mod-name">Testimonials</h2>
      <p class="mod-desc">Default and featured variants</p>
    </div>

    <div class="mod-demo mod-demo--pad">
      <div class="grid grid--2">
        <Testimonial
          quote="Within three weeks of working with Eye Spy Foundation, I found five resources I had searched for on my own for two years. I wish I had found this sooner."
          name="Marcus T. [NEEDS HUMAN VERIFICATION]"
          attribution="Navigation support participant"
          variant="default"
        />
        <Testimonial
          quote="The Eye Spy Social was the first time I felt truly part of a community that understood my experience. I left with new connections and resources I didn't know existed."
          name="Diana R. [NEEDS HUMAN VERIFICATION]"
          attribution="Eye Spy Social participant"
          variant="featured"
        />
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Impact Metrics
  ════════════════════════════════════════════════ -->
  <div class="mod-section mod-section--alt">
    <div class="mod-meta">
      <h2 class="mod-name">Impact Metrics</h2>
      <p class="mod-desc">Stat grid — light and dark contexts</p>
    </div>

    <div class="mod-variant-label">Light</div>
    <div class="mod-demo mod-demo--pad">
      <ImpactMetrics
        eyebrow="Our Impact"
        heading="Real people. Real change. (Light)"
        metrics={SAMPLE_METRICS}
      />
    </div>

    <div class="mod-variant-label">Dark band</div>
    <div class="mod-demo mod-demo--tinted mod-demo--dark">
      <ImpactMetrics
        eyebrow="Our Impact"
        heading="Real people. Real change. (Dark)"
        metrics={SAMPLE_METRICS}
      />
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: FAQ
  ════════════════════════════════════════════════ -->
  <div class="mod-section">
    <div class="mod-meta">
      <h2 class="mod-name">FAQ</h2>
      <p class="mod-desc">Disclosure accordion — schema auto-generated from same data array</p>
    </div>
    <div class="mod-demo mod-demo--pad">
      <FAQ faqs={SAMPLE_FAQS} heading="Frequently Asked Questions" headingLevel="h3" />
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Donation Form
  ════════════════════════════════════════════════ -->
  <div class="mod-section mod-section--alt">
    <div class="mod-meta">
      <h2 class="mod-name">Donation Form</h2>
      <p class="mod-desc">Stripe Payment Links — no custom card capture, Stripe-hosted checkout</p>
    </div>
    <div class="mod-demo mod-demo--pad">
      <DonationForm
        amounts={[25, 50, 100, 250]}
        impactMap={{
          25: 'covers one month of assistive technology support',
          50: 'funds a navigation consultation for two people',
          100: 'runs a free community workshop open to everyone',
          250: 'equips a family for a full year of support',
        }}
        heading="Make an Impact Today"
      />
    </div>
  </div>

  <!-- ════════════════════════════════════════════════
       SECTION: Image Placeholder
  ════════════════════════════════════════════════ -->
  <div class="mod-section">
    <div class="mod-meta">
      <h2 class="mod-name">Image Placeholder</h2>
      <p class="mod-desc">Stand-in for photos not yet taken. Policy: people are always real photos, never AI.</p>
    </div>
    <div class="mod-demo mod-demo--pad">
      <div class="grid grid--3">
        <ImagePlaceholder label="[Community event — wide]" ratio="16 / 9" policy="real" icon="📷" tone="teal" />
        <ImagePlaceholder label="[Program illustration]" ratio="16 / 9" policy="ai" icon="🖼️" tone="gold" />
        <ImagePlaceholder label="[Portrait — participant]" ratio="3 / 4" policy="real" icon="📷" tone="teal" />
      </div>
    </div>
  </div>

</BaseLayout>

<style>
  /* ── Modules page shell ── */
  .mod-page-header {
    background: var(--color-dark);
    color: #ffffff;
    padding: var(--space-m) clamp(1rem, 4vw, 2rem);
  }
  .mod-page-header__inner { max-width: 72rem; margin-inline: auto; }
  .mod-page-header h1 {
    margin: 0 0 0.25rem;
    font-size: var(--step-2);
    color: #ffffff;
  }
  .mod-page-header p {
    margin: 0;
    color: rgba(255,255,255,0.7);
    font-size: 0.875rem;
  }
  .mod-page-header code {
    background: rgba(255,255,255,0.12);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.85em;
  }

  /* ── Section wrappers ── */
  .mod-section {
    border-top: 1px solid var(--color-border);
    padding-bottom: var(--space-l);
  }
  .mod-section--alt { background: var(--color-surface); }

  .mod-meta {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--space-m) clamp(1rem,4vw,2rem) 0;
  }
  .mod-name {
    font-size: var(--step-1);
    margin: 0 0 0.2rem;
    color: var(--color-accent);
  }
  .mod-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  /* ── Variant label ── */
  .mod-variant-label {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--space-m) clamp(1rem,4vw,2rem) var(--space-xs);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ── Demo container ── */
  .mod-demo { margin-bottom: 0; }
  .mod-demo--pad {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--space-s) clamp(1rem,4vw,2rem);
  }
  /* Background-tinted demo blocks (dark / brand) need equal padding all sides */
  .mod-demo--tinted {
    padding: var(--space-m) clamp(1rem,4vw,2rem);
    margin-bottom: 0;
  }
  .mod-demo--row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    align-items: center;
  }
  .mod-demo--dark { background: var(--color-dark); color: #ffffff; }
  .mod-demo--brand { background: var(--color-brand); }

  /* ── Color swatches ── */
  .color-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-s);
  }
  .swatch__chip {
    height: 3.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.5rem;
  }
  .swatch__chip--white { background: #FFFFFF; border: 2px solid #e0e0e0; }
  .swatch__chip--grey { background: #F2F2F2; border: 2px solid #e0e0e0; }
  .swatch__chip--black { background: #222222; }
  .swatch__chip--accent { background: #A83A05; }
  .swatch__chip--brand { background: #F37121; }
  .swatch__chip--peach { background: #FBCDB1; border: 2px solid #e0e0e0; }
  .swatch__chip--wink { background: #5E7AC3; }
  .swatch__chip--border { background: #767676; }
  .swatch__name { font-weight: 700; font-size: 0.85rem; margin: 0 0 0.1rem; }
  .swatch__hex { font-size: 0.75rem; color: var(--color-text-muted); margin: 0 0 0.1rem; font-family: monospace; }
  .swatch__ratio { font-size: 0.7rem; color: var(--color-accent); margin: 0; font-weight: 600; }

  /* ── Lead text (reused from global, scoped here for modules page body) ── */
  .lead { font-size: var(--step-1); }

  /* ── Type-scale demo (non-heading elements styled to match h1/h2/h3) ── */
  .demo-type {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    line-height: 1.1;
    text-wrap: balance;
    color: var(--color-text);
  }
  .demo-type--h1 { margin-top: 0; font-size: var(--step-3); letter-spacing: -0.01em; }
  .demo-type--h2 { font-size: var(--step-2); }
  .demo-type--h3 { font-size: var(--step-1); }
  .demo-type--lead { margin: 1rem 0 0; }
  .demo-type--body { margin: 0.75rem 0 0; }
  .demo-type--muted { margin: 0.5rem 0 0; color: var(--color-text-muted); }
</style>
