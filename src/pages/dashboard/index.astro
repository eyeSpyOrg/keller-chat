@media (max-width: 600px) {
  #dash-content { padding: 12px 12px 32px; gap: 20px; }
  .conn-item { flex-wrap: wrap; }
  .conn-actions { width: 100%; justify-content: flex-end; }
  .dash-section-header { flex-direction: column; align-items: flex-start; gap: 10px; }
}

@media (prefers-reduced-motion: reduce) {
  *,*::before,*::after { animation-duration:.01ms!important; transition-duration:.01ms!important; }
}
</style>

<script>
const srStatus = document.getElementById('sr-status');
function announce(msg: string) {
  if (!srStatus) return;
  srStatus.textContent = '';
  requestAnimationFrame(() => { srStatus.textContent = msg; });
}

/* ── Reminders ──────────────────────────────────────────────── */
let remindCount = document.querySelectorAll('.remind-item').length;
const remindBadge = document.querySelector('.dash-badge--warn');

document.querySelectorAll<HTMLButtonElement>('.remind-done').forEach(btn => {
  btn.addEventListener('click', () => {
    const item = btn.closest('.remind-item')!;
    item.classList.add('done');
    btn.disabled = true;
    remindCount = Math.max(0, remindCount - 1);
    if (remindBadge) { remindBadge.textContent = String(remindCount); remindBadge.hidden = remindCount === 0; }
    announce('Reminder marked as done.');
  });
});

/* ── Connection accept / decline ────────────────────────────── */
let pendingCount = 2;
const dashBadge = document.querySelector('.dash-badge');

document.querySelectorAll<HTMLButtonElement>('.conn-btn.accept').forEach(btn => {
  btn.addEventListener('click', () => {
    const li   = btn.closest('li')!;
    const name = btn.dataset.name || 'Navigator';
    li.remove();
    pendingCount = Math.max(0, pendingCount - 1);
    if (dashBadge) { dashBadge.textContent = String(pendingCount); dashBadge.hidden = pendingCount === 0; }
    announce(`Connected with ${name}. Chat session started.`);
  });
});

document.querySelectorAll<HTMLButtonElement>('.conn-btn.decline').forEach(btn => {
  btn.addEventListener('click', () => {
    const li   = btn.closest('li')!;
    const name = li.querySelector('.conn-name')?.textContent || 'Navigator';
    li.remove();
    pendingCount = Math.max(0, pendingCount - 1);
    if (dashBadge) { dashBadge.textContent = String(pendingCount); dashBadge.hidden = pendingCount === 0; }
    announce(`Connection from ${name} declined.`);
  });
});

/* ── Transfer modal ─────────────────────────────────────────── */
const transferModal   = document.getElementById('transfer-modal')!;
const transferClose   = document.getElementById('transfer-close')!;
const transferCancel  = document.getElementById('transfer-cancel')!;
const transferConfirm = document.getElementById('transfer-confirm') as HTMLButtonElement;
const transferSelect  = document.getElementById('transfer-select') as HTMLSelectElement;
const transferLeadDisplay = document.getElementById('transfer-lead-display')!;

function openTransfer(leadName: string) {
  transferLeadDisplay.textContent = leadName;
  transferSelect.value = '';
  (document.getElementById('transfer-note') as HTMLTextAreaElement).value = '';
  transferConfirm.disabled = true;
  transferModal.hidden = false;
  transferSelect.focus();
  announce(`Transfer dialog opened for ${leadName}. Select a navigator.`);
}
function closeTransfer() { transferModal.hidden = true; }

document.querySelectorAll<HTMLButtonElement>('.conn-btn.transfer').forEach(btn => {
  btn.addEventListener('click', () => openTransfer(btn.dataset.name || 'lead'));
});
transferClose.addEventListener('click', closeTransfer);
transferCancel.addEventListener('click', closeTransfer);
transferModal.addEventListener('click', e => { if (e.target === transferModal) closeTransfer(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && !transferModal.hidden) closeTransfer(); });

transferSelect.addEventListener('change', () => {
  transferConfirm.disabled = !transferSelect.value;
});
transferConfirm.addEventListener('click', () => {
  const dest = transferSelect.options[transferSelect.selectedIndex].text;
  const lead = transferLeadDisplay.textContent;
  // TODO: POST /api/hubspot/transfer — log CRM swim-lane move
  console.log('[Transfer]', lead, '→', dest);
  announce(`${lead} transferred to ${dest}.`);
  // Remove the connection row from the list
  document.querySelectorAll<HTMLButtonElement>('.conn-btn.transfer').forEach(btn => {
    if (btn.dataset.name === lead) btn.closest('li')?.remove();
  });
  pendingCount = Math.max(0, pendingCount - 1);
  if (dashBadge) { dashBadge.textContent = String(pendingCount); dashBadge.hidden = pendingCount === 0; }
  closeTransfer();
});

/* ── Activity filter tabs ───────────────────────────────────── */
const tabs  = document.querySelectorAll<HTMLButtonElement>('.act-tab');
const items = document.querySelectorAll<HTMLLIElement>('.act-item');

tabs.forEach(tab => {
  tab.addEventListener('click', () => {
    const filter = tab.dataset.filter!;
    tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-pressed', 'false'); });
    tab.classList.add('active');
    tab.setAttribute('aria-pressed', 'true');
    items.forEach(item => {
      item.hidden = filter !== 'all' && item.dataset.type !== filter;
    });
    const label = filter === 'all' ? 'All activity' : `${tab.textContent} only`;
    announce(`Showing: ${label}`);
  });
});
</script>
