.crm-stage.to   { background: rgba(243,113,33,.15); color: var(--kc-orange); }
.act-time {
  font-size: .75rem;
  color: var(--kc-text-3);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  margin-top: 3px;
}

