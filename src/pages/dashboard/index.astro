---
/**
 * KellerChat Navigator Dashboard
 * Pending connections + HubSpot CRM activity section.
 * chatMode hides site Header/Footer; dashboard provides its own chrome.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dashboard"
  description="Navigator dashboard — manage connections and review CRM activity for Eye Spy Foundation's KellerChat network."
  chatMode={true}
>
  <div id="dash-shell">

    <!-- Dashboard app header -->
    <header id="dash-header" role="banner">
      <a href="/" class="dash-back" aria-label="Back to chat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        Chat
      </a>

      <h1 class="dash-title">Dashboard</h1>

      <a href="/login/" class="dash-auth-btn" aria-label="Log out of KellerChat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        <span class="dash-auth-label">Log out</span>
      </a>
    </header>

    <div id="dash-content">

      <!-- ── Connections ─────────────────────────────────────── -->
      <section class="dash-section" aria-labelledby="connections-heading">
        <div class="dash-section-header">
          <h2 id="connections-heading" class="dash-section-title">
            Connections
            <span class="dash-badge" role="img" aria-label="2 pending">2</span>
          </h2>
        </div>

        <ul class="conn-list" role="list">

          <li class="conn-item">
            <div class="conn-avatar" aria-hidden="true">MR</div>
            <div class="conn-info">
              <div class="conn-name">Maria R.</div>
              <div class="conn-role">Navigator — UF Health Jacksonville</div>
              <div class="conn-meta">Referred 2 min ago</div>
            </div>
            <div class="conn-actions">
              <button class="conn-btn accept" data-name="Maria R." aria-label="Accept connection from Maria R.">Accept</button>
              <button class="conn-btn decline" aria-label="Decline connection from Maria R.">Decline</button>
              <button class="conn-btn transfer" data-name="Maria R." aria-label="Transfer lead from Maria R. to another navigator" aria-haspopup="dialog">Transfer</button>
            </div>
          </li>

          <li class="conn-item">
            <div class="conn-avatar" aria-hidden="true">JT</div>
            <div class="conn-info">
              <div class="conn-name">James T.</div>
              <div class="conn-role">Patient — Arlington Low Vision</div>
              <div class="conn-meta">Referred 8 min ago</div>
            </div>
            <div class="conn-actions">
              <button class="conn-btn accept" data-name="James T." aria-label="Accept connection from James T.">Accept</button>
              <button class="conn-btn decline" aria-label="Decline connection from James T.">Decline</button>
              <button class="conn-btn transfer" data-name="James T." aria-label="Transfer lead from James T. to another navigator" aria-haspopup="dialog">Transfer</button>
            </div>
          </li>

        </ul>
      </section>

      <!-- ── Reminders ──────────────────────────────────────── -->
      <section class="dash-section reminders-section" aria-labelledby="reminders-heading">
        <div class="dash-section-header">
          <h2 id="reminders-heading" class="dash-section-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            Reminders
            <span class="dash-badge dash-badge--warn" role="img" aria-label="3 reminders">3</span>
          </h2>
          <button class="remind-add-btn" aria-label="Add a reminder">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add
          </button>
        </div>

        <ul class="remind-list" role="list">

          <li class="remind-item remind-item--urgent">
            <div class="remind-indicator" aria-hidden="true"></div>
            <div class="remind-body">
              <div class="remind-text">Follow up with <strong>Maria R.</strong> — O&amp;M referral confirmation due</div>
              <div class="remind-meta">Today · 11:00 AM</div>
            </div>
            <button class="remind-done" aria-label="Mark reminder as done: Follow up with Maria R.">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </li>

          <li class="remind-item">
            <div class="remind-indicator" aria-hidden="true"></div>
            <div class="remind-body">
              <div class="remind-text">Schedule three-way call with <strong>James T.</strong> and Brooks Rehabilitation</div>
              <div class="remind-meta">Today · 2:00 PM</div>
            </div>
            <button class="remind-done" aria-label="Mark reminder as done: Schedule three-way call with James T.">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </li>

          <li class="remind-item">
            <div class="remind-indicator" aria-hidden="true"></div>
            <div class="remind-body">
              <div class="remind-text">Send <strong>Sofia K.</strong> assistive technology resource list</div>
              <div class="remind-meta">Tomorrow · 9:00 AM</div>
            </div>
            <button class="remind-done" aria-label="Mark reminder as done: Send Sofia K. resource list">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </li>

        </ul>
      </section>

      <!-- ── Activity Section ───────────────────────────────── -->
      <section class="dash-section" aria-labelledby="activity-heading">
        <div class="dash-section-header">
          <h2 id="activity-heading" class="dash-section-title">Activity</h2>

          <!-- Filter tabs -->
          <div class="act-tabs" role="group" aria-label="Filter activity">
            <button class="act-tab active" data-filter="all" aria-pressed="true">All</button>
            <button class="act-tab" data-filter="calls" aria-pressed="false">Calls</button>
            <button class="act-tab" data-filter="emails" aria-pressed="false">Emails</button>
          </div>
        </div>

        <ol class="act-list" role="list" aria-label="Activity feed">

          <li class="act-item" data-type="call">
            <div class="act-icon act-icon--call" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.72 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.98-.98a2 2 0 0 1 2.1-.45c.9.36 1.85.6 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="act-body">
              <div class="act-headline"><strong>Maria R.</strong> — Outbound call</div>
              <div class="act-detail">Duration: 4 min 32 sec · Discussed O&amp;M referral to Brooks Rehabilitation</div>
            </div>
            <time class="act-time" datetime="2026-09-20T09:04">9:04 AM</time>
          </li>

          <li class="act-item" data-type="crm">
            <div class="act-icon act-icon--crm" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8l4 4-4 4M3 12h18"/></svg>
            </div>
            <div class="act-body">
              <div class="act-headline"><strong>James T.</strong> — Swim lane moved</div>
              <div class="act-detail">
                <span class="crm-stage from">New Lead</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                <span class="crm-stage to">Contacted</span>
              </div>
            </div>
            <time class="act-time" datetime="2026-09-20T08:58">8:58 AM</time>
          </li>

          <li class="act-item" data-type="email">
            <div class="act-icon act-icon--email" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="act-body">
              <div class="act-headline"><strong>Sofia K.</strong> — Email sent</div>
              <div class="act-detail">Follow-up on low-vision assistive technology resources</div>
            </div>
            <time class="act-time" datetime="2026-09-20T08:45">8:45 AM</time>
          </li>

          <li class="act-item" data-type="crm">
            <div class="act-icon act-icon--crm" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8l4 4-4 4M3 12h18"/></svg>
            </div>
            <div class="act-body">
              <div class="act-headline"><strong>David M.</strong> — Swim lane moved</div>
              <div class="act-detail">
                <span class="crm-stage from">Contacted</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                <span class="crm-stage to">Qualified</span>
              </div>
            </div>
            <time class="act-time" datetime="2026-09-20T08:30">8:30 AM</time>
          </li>

          <li class="act-item" data-type="call">
            <div class="act-icon act-icon--call" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.72 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.98-.98a2 2 0 0 1 2.1-.45c.9.36 1.85.6 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="act-body">
              <div class="act-headline"><strong>Anya V.</strong> — Inbound call</div>
              <div class="act-detail">Duration: 2 min 10 sec · Navigator inquiry about patient referral process</div>
            </div>
            <time class="act-time" datetime="2026-09-20T08:15">8:15 AM</time>
          </li>

          <li class="act-item" data-type="email">
            <div class="act-icon act-icon--email" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="act-body">
              <div class="act-headline"><strong>Maria R.</strong> — Email received</div>
              <div class="act-detail">Patient discharge summary forwarded from UF Health Jacksonville</div>
            </div>
            <time class="act-time" datetime="2026-09-20T07:52">7:52 AM</time>
          </li>

          <li class="act-item" data-type="crm">
            <div class="act-icon act-icon--crm" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8l4 4-4 4M3 12h18"/></svg>
            </div>
            <div class="act-body">
              <div class="act-headline"><strong>Sofia K.</strong> — Swim lane moved</div>
              <div class="act-detail">
                <span class="crm-stage from">Qualified</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                <span class="crm-stage to">Services Active</span>
              </div>
            </div>
            <time class="act-time" datetime="2026-09-19T16:30">Yesterday</time>
          </li>

        </ol>
      </section>

    </div><!-- /#dash-content -->

    <!-- Live region for announcements -->
    <div id="sr-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

  </div><!-- /#dash-shell -->

  <!-- Transfer lead modal -->
  <div id="transfer-modal" role="dialog" aria-modal="true" aria-labelledby="transfer-title" hidden>
    <div class="transfer-card">
      <div class="transfer-hdr">
        <h2 id="transfer-title" class="transfer-title-text">Transfer Lead</h2>
        <button class="transfer-close" id="transfer-close" aria-label="Close transfer dialog">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <p class="transfer-lead-name">Transferring: <strong id="transfer-lead-display">—</strong></p>
      <div class="transfer-form">
        <label for="transfer-select" class="transfer-label">Select navigator</label>
        <select id="transfer-select" class="transfer-select">
          <option value="">— Choose a navigator —</option>
          <option value="sofia-k">Sofia K. — Arlington Low Vision</option>
          <option value="david-m">David M. — Eye Spy HQ</option>
          <option value="anya-v">Anya V. — UF Health Jacksonville</option>
          <option value="leo-p">Leo P. — Brooks Rehabilitation</option>
        </select>
        <label for="transfer-note" class="transfer-label">Note <span class="transfer-opt">(optional)</span></label>
        <textarea id="transfer-note" class="transfer-textarea" rows="3" placeholder="Context for the receiving navigator…"></textarea>
      </div>
      <div class="transfer-actions">
        <button id="transfer-confirm" class="transfer-action transfer-action--confirm" disabled>Transfer Lead</button>
        <button id="transfer-cancel"  class="transfer-action transfer-action--cancel">Cancel</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
/* ── Hide site chrome ───────────────────────────────────────── */
:global(body) { background: var(--kc-bg, #09101F) !important; font-family: 'Open Sans', system-ui, sans-serif !important; }
:global(body > .site-header),
:global(body > .site-footer) { display: none !important; }
:global(#main-content) { padding: 0 !important; }

/* ── KellerChat token system — dashboard always dark ────────── */
#dash-shell,
#dash-shell * {
  --kc-bg:          #09101F;
  --kc-surface:     #101825;
  --kc-surface-2:   #192236;
  --kc-surface-3:   #1E2D48;
  --kc-border:      #1E2D48;
  --kc-accent:      #5E7AC3;
  --kc-accent-dim:  rgba(94,122,195,.15);
  --kc-orange:      #F37121;
  --kc-burnt:       #933001;
  --kc-text-1:      #EDF1FF;
  --kc-text-2:      #7A95C4;
  --kc-text-3:      #8FA8CC;
  --kc-success:     #3FD278;
  --kc-warning:     #F5BC4B;
  --kc-danger:      #F56B6B;
  --kc-font-display: 'Poppins', system-ui, sans-serif;
  --kc-radius:      10px;
  --kc-radius-lg:   16px;
}

/* ── Shell ──────────────────────────────────────────────────── */
#dash-shell {
  display: flex;
  flex-direction: column;
  min-height: calc(100dvh - var(--a11y-bar-h, 44px));
  background: var(--kc-bg);
  color: var(--kc-text-1);
}

/* ── App header ─────────────────────────────────────────────── */
#dash-header {
  height: 64px;
  background: var(--kc-surface);
  border-bottom: 1px solid var(--kc-border);
  display: flex;
  align-items: center;
  padding-inline: 20px;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 10;
  flex-shrink: 0;
}
.dash-back {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--kc-text-1);
  text-decoration: none;
  font-family: var(--kc-font-display);
  font-size: .875rem;
  font-weight: 600;
  padding: 6px 10px;
  border-radius: 8px;
  transition: background .12s;
  flex-shrink: 0;
}
.dash-back:hover { background: var(--kc-accent-dim); }
.dash-back:focus-visible { outline: 3px solid var(--kc-accent); outline-offset: 2px; }
.dash-title {
  flex: 1;
  font-family: var(--kc-font-display);
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0;
  text-align: center;
  color: var(--kc-text-1);
}
.dash-auth-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--kc-text-2);
  text-decoration: none;
  font-family: var(--kc-font-display);
  font-size: .875rem;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 8px;
  border: 1px solid var(--kc-border);
  transition: background .12s, color .12s;
  flex-shrink: 0;
}
.dash-auth-btn:hover { background: var(--kc-surface-2); color: var(--kc-text-1); }
.dash-auth-btn:focus-visible { outline: 3px solid var(--kc-accent); outline-offset: 2px; }

/* ── Content area ───────────────────────────────────────────── */
#dash-content {
  flex: 1;
  padding: 20px 20px 40px;
  max-width: 760px;
  width: 100%;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

/* ── Section wrapper ────────────────────────────────────────── */
.dash-section {
  background: var(--kc-surface);
  border: 1px solid var(--kc-border);
  border-radius: var(--kc-radius-lg);
  overflow: hidden;
}
.dash-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  border-bottom: 1px solid var(--kc-border);
  gap: 12px;
  flex-wrap: wrap;
}
.dash-section-title {
  font-family: var(--kc-font-display);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: .01em;
  color: var(--kc-text-1);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.dash-badge {
  display: inline-grid;
  place-items: center;
  min-width: 20px;
  height: 20px;
  padding-inline: 6px;
  background: var(--kc-danger);
  color: #fff;
  font-size: .7rem;
  font-weight: 700;
  border-radius: 999px;
  font-variant-numeric: tabular-nums;
}

/* ── Connections list ───────────────────────────────────────── */
.conn-list { display: flex; flex-direction: column; gap: 0; list-style: none; }
.conn-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--kc-border);
}
.conn-item:last-child { border-bottom: none; }
.conn-avatar {
  width: 42px; height: 42px;
  border-radius: 50%;
  background: var(--kc-accent);
  border: 2px solid var(--kc-accent);
  display: grid;
  place-items: center;
  font-family: var(--kc-font-display);
  font-weight: 700;
  font-size: .875rem;
  color: #000000;
  flex-shrink: 0;
}
.conn-info { flex: 1; min-width: 0; }
.conn-name { font-size: .9375rem; font-weight: 700; color: var(--kc-text-1); line-height: 1.3; }
.conn-role { font-size: .8125rem; color: var(--kc-text-2); margin-top: 2px; }
.conn-meta { font-size: .75rem; color: var(--kc-text-3); margin-top: 3px; }
.conn-actions { display: flex; gap: 8px; flex-shrink: 0; }
.conn-btn {
  min-height: 44px;
  padding-inline: 14px;
  border-radius: 8px;
  border: none;
  font-family: var(--kc-font-display);
  font-size: .8rem;
  font-weight: 700;
  cursor: pointer;
  transition: opacity .15s;
  min-width: 72px;
}
.conn-btn:focus-visible { outline: 3px solid var(--kc-accent); outline-offset: 2px; }
.conn-btn.accept   { background: var(--kc-success); color: #000; }
.conn-btn.decline  { background: var(--kc-surface-3); color: var(--kc-text-2); }
.conn-btn.transfer { background: rgba(243,113,33,.15); color: var(--kc-orange); border: 1px solid rgba(243,113,33,.35); }
.conn-btn.transfer:hover { background: rgba(243,113,33,.25); }
.conn-btn:hover    { opacity: .85; }
.conn-btn.transfer:hover { opacity: 1; }

/* ── Transfer modal ─────────────────────────────────────────── */
#transfer-modal {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(9,16,31,.75);
  backdrop-filter: blur(4px);
}
#transfer-modal[hidden] { display: none !important; }
.transfer-card {
  width: 100%;
  max-width: 420px;
  background: var(--kc-surface);
  border: 1px solid var(--kc-border);
  border-radius: var(--kc-radius-lg);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.transfer-hdr { display: flex; align-items: center; justify-content: space-between; }
.transfer-title-text { font-family: var(--kc-font-display); font-size: 1.05rem; font-weight: 700; color: var(--kc-text-1); margin: 0; }
.transfer-close {
  width: 32px; height: 32px; display: grid; place-items: center;
  background: transparent; border: none; color: var(--kc-text-2);
  cursor: pointer; border-radius: 6px; transition: background .12s;
}
.transfer-close:hover { background: var(--kc-surface-2); }
.transfer-close:focus-visible { outline: 3px solid var(--kc-accent); outline-offset: 2px; }
.transfer-lead-name { font-size: .875rem; color: var(--kc-text-2); margin: 0; }
.transfer-lead-name strong { color: var(--kc-orange); }
.transfer-form { display: flex; flex-direction: column; gap: 10px; }
.transfer-label { font-size: .8rem; font-weight: 600; color: var(--kc-text-2); }
.transfer-opt { font-weight: 400; opacity: .7; }
.transfer-select,
.transfer-textarea {
  background: var(--kc-surface-2); border: 1px solid var(--kc-border);
  border-radius: var(--kc-radius); color: var(--kc-text-1);
  font-family: 'Open Sans', system-ui, sans-serif; font-size: .9rem;
  padding: 10px 12px; width: 100%; transition: border-color .15s;
}
.transfer-select:focus, .transfer-textarea:focus { outline: none; border-color: var(--kc-accent); }
.transfer-textarea { resize: vertical; min-height: 80px; line-height: 1.5; }
.transfer-actions { display: flex; gap: 8px; }
.transfer-action {
  flex: 1; height: 44px; border-radius: var(--kc-radius); border: none;
  font-family: var(--kc-font-display); font-size: .875rem; font-weight: 700;
  cursor: pointer; transition: opacity .15s;
}
.transfer-action:focus-visible { outline: 3px solid var(--kc-accent); outline-offset: 2px; }
.transfer-action--confirm { background: var(--kc-burnt); color: #fff; }
.transfer-action--confirm:disabled { opacity: .4; cursor: not-allowed; }
.transfer-action--cancel { background: var(--kc-surface-3); color: var(--kc-text-2); }
.transfer-action:not(:disabled):hover { opacity: .88; }

/* ── Reminders ──────────────────────────────────────────────── */
.dash-badge--warn { background: var(--kc-warning); color: #000; }

.remind-add-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 44px;
  padding-inline: 10px;
  border-radius: 6px;
  border: 1px solid var(--kc-border);
  background: transparent;
  color: var(--kc-text-2);
  font-family: var(--kc-font-display);
  font-size: .8rem;
  font-weight: 600;
  cursor: pointer;
  transition: background .12s, color .12s;
}
.remind-add-btn:hover { background: var(--kc-surface-2); color: var(--kc-text-1); }
.remind-add-btn:focus-visible { outline: 3px solid var(--kc-accent); outline-offset: 2px; }

.remind-list { display: flex; flex-direction: column; list-style: none; }
.remind-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--kc-border);
  transition: background .1s;
}
.remind-item:last-child { border-bottom: none; }
.remind-item:hover { background: var(--kc-surface-2); }
.remind-item.done { opacity: .45; }
.remind-item.done .remind-text { text-decoration: line-through; }

.remind-indicator {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--kc-accent);
  flex-shrink: 0;
}
.remind-item--urgent .remind-indicator { background: var(--kc-warning); }
.remind-item.done    .remind-indicator { background: var(--kc-text-3); }

.remind-body { flex: 1; min-width: 0; }
.remind-text { font-size: .875rem; color: var(--kc-text-1); line-height: 1.5; }
.remind-meta { font-size: .8rem; color: var(--kc-text-3); margin-top: 3px; }
.remind-item--urgent .remind-meta { color: var(--kc-warning); }

.remind-done {
  width: 44px; height: 44px;
  border-radius: 50%;
  border: 2px solid var(--kc-border);
  background: transparent;
  color: var(--kc-text-3);
  display: grid;
  place-items: center;
  cursor: pointer;
  flex-shrink: 0;
  transition: background .12s, border-color .12s, color .12s;
}
.remind-done:hover { background: rgba(63,210,120,.12); border-color: var(--kc-success); color: var(--kc-success); }
.remind-done:focus-visible { outline: 3px solid var(--kc-accent); outline-offset: 2px; }

/* ── Activity tabs ──────────────────────────────────────────── */
.act-tabs { display: flex; gap: 4px; }
.act-tab {
  min-height: 44px;
  padding-inline: 12px;
  border-radius: 6px;
  border: 1px solid transparent;
  background: transparent;
  font-family: var(--kc-font-display);
  font-size: .8rem;
  font-weight: 600;
  color: var(--kc-text-2);
  cursor: pointer;
  transition: background .12s, color .12s, border-color .12s;
}
.act-tab:hover { background: var(--kc-surface-2); color: var(--kc-text-1); }
.act-tab:focus-visible { outline: 3px solid var(--kc-accent); outline-offset: 2px; }
.act-tab.active {
  background: var(--kc-accent);
  color: #000000;
  border-color: var(--kc-accent);
}

/* ── Activity list ──────────────────────────────────────────── */
.act-list { display: flex; flex-direction: column; list-style: none; }
.act-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--kc-border);
  transition: background .1s;
}
.act-item:last-child { border-bottom: none; }
.act-item[hidden] { display: none !important; }
.act-item:hover { background: var(--kc-surface-2); }
.act-icon {
  width: 32px; height: 32px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  margin-top: 1px;
}
.act-icon--call  { background: rgba(63,210,120,.12); color: var(--kc-success); }
.act-icon--email { background: rgba(94,122,195,.12); color: var(--kc-accent); }
.act-icon--crm   { background: rgba(243,113,33,.12); color: var(--kc-orange); }
.act-body { flex: 1; min-width: 0; }
.act-headline {
  font-size: .875rem;
  font-weight: 600;
  color: var(--kc-text-1);
  line-height: 1.4;
}
.act-detail {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: .8125rem;
  color: var(--kc-text-2);
  margin-top: 3px;
  line-height: 1.5;
  flex-wrap: wrap;
}
.crm-stage {
  display: inline-block;
  padding: 1px 7px;
  border-radius: 4px;
  font-size: .75rem;
  font-weight: 600;
}
.crm-stage.from { background: var(--kc-surface-3); color: var(--kc-text-2); }
.crm-stage.to   { background: rgba(243,113,33,.15); color: var(--kc-orange); }
.act-time {
  font-size: .75rem;
  color: var(--kc-text-3);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  margin-top: 3px;
}

/* ── Utility ────────────────────────────────────────────────── */
.sr-only {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 600px) {
  #dash-content { padding: 12px 12px 32px; gap: 20px; }
  .conn-item { flex-wrap: wrap; }
  .conn-actions { width: 100%; justify-content: flex-end; }
  .dash-section-header { flex-direction: column; align-items: flex-start; gap: 10px; }
  .conn-btn { flex: 1; }
}
@media (max-width: 480px) {
  .dash-auth-label { display: none; }
  #dash-header { padding-inline: 12px; gap: 8px; }
  .dash-back { padding: 6px 8px; }
  .dash-auth-btn { padding: 6px 8px; border-radius: 8px; }
  .dash-title { font-size: 1rem; }
}

@media (prefers-reduced-motion: reduce) {
  *,*::before,*::after { animation-duration:.01ms!important; transition-duration:.01ms!important; }
}
</style>

<script>
// ─────────────────────────────────────────────────────────────────────────────
// KellerChat Navigator Dashboard — live HubSpot data
// All data is fetched from /api/* routes that proxy to HubSpot server-side.
// The HubSpot Private App token never reaches the browser.
// ─────────────────────────────────────────────────────────────────────────────

// ── Utilities ────────────────────────────────────────────────────────────────

function esc(str: string): string {
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

const srStatus = document.getElementById('sr-status');
function announce(msg: string) {
  if (!srStatus) return;
  srStatus.textContent = '';
  requestAnimationFrame(() => { srStatus.textContent = msg; });
}

function initials(name: string): string {
  return name.split(' ').filter(Boolean).map(w => w[0]).join('').slice(0, 2).toUpperCase() || '?';
}

function relativeTime(iso: string): string {
  if (!iso) return '';
  const diff = Date.now() - new Date(iso).getTime();
  const min = Math.floor(diff / 60000);
  if (min < 1) return 'just now';
  if (min < 60) return `${min} min ago`;
  const hr = Math.floor(min / 60);
  if (hr < 24) return `${hr} hr ago`;
  return new Date(iso).toLocaleDateString();
}

function formatDue(iso: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  const today = new Date(); today.setHours(0,0,0,0);
  const tomorrow = new Date(today); tomorrow.setDate(today.getDate() + 1);
  d.setHours(0,0,0,0);
  const time = new Date(iso).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
  if (d.getTime() === today.getTime()) return `Today · ${time}`;
  if (d.getTime() === tomorrow.getTime()) return `Tomorrow · ${time}`;
  return `${d.toLocaleDateString()} · ${time}`;
}

function durStr(sec: number): string {
  if (!sec) return '';
  const m = Math.floor(sec / 60), s = sec % 60;
  return `${m} min ${s} sec`;
}

// ── Transfer modal references ────────────────────────────────────────────────

const transferModal    = document.getElementById('transfer-modal')!;
const transferClose    = document.getElementById('transfer-close')!;
const transferCancel   = document.getElementById('transfer-cancel')!;
const transferConfirm  = document.getElementById('transfer-confirm') as HTMLButtonElement;
const transferSelect   = document.getElementById('transfer-select') as HTMLSelectElement;
const transferLeadDisplay = document.getElementById('transfer-lead-display')!;
let   transferContactId = '';

function openTransfer(contactId: string, name: string) {
  transferContactId = contactId;
  transferLeadDisplay.textContent = name;
  transferSelect.value = '';
  (document.getElementById('transfer-note') as HTMLTextAreaElement).value = '';
  transferConfirm.disabled = true;
  transferModal.hidden = false;
  transferSelect.focus();
  announce(`Transfer dialog opened for ${name}. Select a navigator.`);
}
function closeTransfer() { transferModal.hidden = true; transferContactId = ''; }

transferClose.addEventListener('click', closeTransfer);
transferCancel.addEventListener('click', closeTransfer);
transferModal.addEventListener('click', e => { if (e.target === transferModal) closeTransfer(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && !transferModal.hidden) closeTransfer(); });
transferSelect.addEventListener('change', () => { transferConfirm.disabled = !transferSelect.value; });

transferConfirm.addEventListener('click', async () => {
  const dest = transferSelect.options[transferSelect.selectedIndex].text;
  const navigatorOwnerId = transferSelect.value;
  const name = transferLeadDisplay.textContent || '';
  transferConfirm.disabled = true;
  try {
    const res = await fetch(`/api/connections/${transferContactId}/transfer`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ navigatorOwnerId }),
    });
    if (!res.ok) throw new Error(`${res.status}`);
    announce(`${name} transferred to ${dest}.`);
    closeTransfer();
    // Re-render connections so the row updates to Transferred status
    await loadConnections();
  } catch {
    announce('Transfer failed. Please try again.');
    transferConfirm.disabled = false;
  }
});

// ── Connections ──────────────────────────────────────────────────────────────

const connList  = document.querySelector('.conn-list')!;
const dashBadge = document.querySelector<HTMLElement>('.dash-badge');

// Maps contact id → display name for use in button event handlers.
// Avoids injecting names into HTML attribute values.
const connNameMap = new Map<string, string>();

function renderConnections(connections: any[]) {
  const pendingCount = connections.filter(c => c.status === 'New').length;
  if (dashBadge) {
    dashBadge.textContent = String(pendingCount);
    dashBadge.hidden = pendingCount === 0;
    dashBadge.setAttribute('aria-label', `${pendingCount} pending`);
  }

  if (!connections.length) {
    connList.innerHTML = '<li class="conn-item" style="justify-content:center;color:var(--kc-text-2);font-size:.875rem;padding:24px">No connections yet.</li>';
    return;
  }

  // Rebuild the name map before re-rendering so stale entries are cleared.
  connNameMap.clear();
  connections.forEach(c => connNameMap.set(c.id, c.name));

  connList.innerHTML = connections.map(c => {
    const isNew = c.status === 'New';
    const statusLabel = c.status === 'New' ? 'Pending' : esc(c.status);
    const statusColor = c.status === 'Active'
      ? 'var(--kc-success)' : c.status === 'New'
      ? 'var(--kc-warning)' : 'var(--kc-text-3)';
    const name = esc(c.name);
    const type = esc(c.type);
    const source = esc(c.source);
    const id = esc(c.id);
    // data-name is intentionally omitted — names are looked up from connNameMap
    // in event handlers so that quotes/special chars in names cannot break HTML.
    return `
      <li class="conn-item" data-id="${id}">
        <div class="conn-avatar" aria-hidden="true">${esc(initials(c.name))}</div>
        <div class="conn-info">
          <div class="conn-name">${name}</div>
          <div class="conn-role">${type}${source ? ` — ${source}` : ''}</div>
          <div class="conn-meta">${esc(relativeTime(c.referredAt))} &nbsp;·&nbsp;
            <span style="color:${statusColor};font-weight:600">${statusLabel}</span>
          </div>
        </div>
        <div class="conn-actions">
          ${isNew ? `
            <button class="conn-btn accept" data-id="${id}" aria-label="Accept connection from ${name}">Accept</button>
            <button class="conn-btn decline" data-id="${id}" aria-label="Decline connection from ${name}">Decline</button>
            <button class="conn-btn transfer" data-id="${id}" aria-label="Transfer lead from ${name}" aria-haspopup="dialog">Transfer</button>
          ` : `<span style="font-size:.8rem;color:var(--kc-text-3)">${statusLabel}</span>`}
        </div>
      </li>`;
  }).join('');

  // Wire buttons — resolve display names from the map, never from DOM attributes.
  connList.querySelectorAll<HTMLButtonElement>('.conn-btn.accept').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id!;
      const name = connNameMap.get(id) || 'Navigator';
      btn.disabled = true;
      try {
        const res = await fetch(`/api/connections/${id}/accept`, { method: 'PATCH' });
        if (!res.ok) throw new Error(`${res.status}`);
        announce(`Connected with ${name}.`);
        await loadConnections();
      } catch {
        announce('Accept failed. Please try again.');
        btn.disabled = false;
      }
    });
  });

  connList.querySelectorAll<HTMLButtonElement>('.conn-btn.decline').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id!;
      const name = connNameMap.get(id) || 'Navigator';
      btn.disabled = true;
      try {
        const res = await fetch(`/api/connections/${id}/decline`, { method: 'PATCH' });
        if (!res.ok) throw new Error(`${res.status}`);
        announce(`Connection from ${name} declined.`);
        await loadConnections();
      } catch {
        announce('Decline failed. Please try again.');
        btn.disabled = false;
      }
    });
  });

  connList.querySelectorAll<HTMLButtonElement>('.conn-btn.transfer').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id!;
      openTransfer(id, connNameMap.get(id) || 'lead');
    });
  });
}

async function loadConnections() {
  try {
    const res = await fetch('/api/connections');
    if (!res.ok) throw new Error(`${res.status}`);
    renderConnections(await res.json());
  } catch {
    connList.innerHTML = '<li class="conn-item" style="color:var(--kc-danger);padding:16px 20px;font-size:.875rem">Could not load connections.</li>';
  }
}

// ── Reminders ────────────────────────────────────────────────────────────────

const remindList  = document.querySelector('.remind-list')!;
const remindBadge = document.querySelector<HTMLElement>('.dash-badge--warn');
let   remindCount = 0;

function renderReminders(reminders: any[]) {
  remindCount = reminders.length;
  if (remindBadge) {
    remindBadge.textContent = String(remindCount);
    remindBadge.hidden = remindCount === 0;
    remindBadge.setAttribute('aria-label', `${remindCount} reminders`);
  }

  if (!reminders.length) {
    remindList.innerHTML = '<li class="remind-item" style="color:var(--kc-text-2);font-size:.875rem">No open reminders.</li>';
    return;
  }

  const now = Date.now();
  remindList.innerHTML = reminders.map(r => {
    const urgent = r.dueAt && new Date(r.dueAt).getTime() < now + 3600000;
    const subject = esc(r.subject);
    const contactName = esc(r.contactName);
    return `
      <li class="remind-item ${urgent ? 'remind-item--urgent' : ''}" data-id="${esc(r.id)}">
        <div class="remind-indicator" aria-hidden="true"></div>
        <div class="remind-body">
          <div class="remind-text">${contactName ? `${subject} — <strong>${contactName}</strong>` : subject}</div>
          <div class="remind-meta">${esc(formatDue(r.dueAt))}</div>
        </div>
        <button class="remind-done" aria-label="Mark reminder as done: ${subject}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
      </li>`;
  }).join('');

  remindList.querySelectorAll<HTMLButtonElement>('.remind-done').forEach(btn => {
    btn.addEventListener('click', async () => {
      const li = btn.closest('.remind-item') as HTMLElement;
      const id = li.dataset.id!;
      btn.disabled = true;
      li.classList.add('done');
      try {
        const res = await fetch('/api/reminders', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        if (!res.ok) throw new Error(`${res.status}`);
        remindCount = Math.max(0, remindCount - 1);
        if (remindBadge) { remindBadge.textContent = String(remindCount); remindBadge.hidden = remindCount === 0; }
        announce('Reminder marked as done.');
      } catch {
        li.classList.remove('done');
        btn.disabled = false;
        announce('Could not complete reminder. Please try again.');
      }
    });
  });
}

async function loadReminders() {
  try {
    const res = await fetch('/api/reminders');
    if (!res.ok) throw new Error(`${res.status}`);
    renderReminders(await res.json());
  } catch {
    remindList.innerHTML = '<li class="remind-item" style="color:var(--kc-danger);padding:16px 20px;font-size:.875rem">Could not load reminders.</li>';
  }
}

// ── Activity ─────────────────────────────────────────────────────────────────

const actList = document.querySelector('.act-list')!;
const actTabs = document.querySelectorAll<HTMLButtonElement>('.act-tab');
let   actFilter = 'all';

function callIcon() {
  return `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.72 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.98-.98a2 2 0 0 1 2.1-.45c.9.36 1.85.6 2.81.72A2 2 0 0 1 22 16.92z"/></svg>`;
}
function emailIcon() {
  return `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`;
}

function renderActivity(items: any[]) {
  if (!items.length) {
    actList.innerHTML = '<li class="act-item" style="color:var(--kc-text-2);font-size:.875rem">No activity yet.</li>';
    return;
  }
  actList.innerHTML = items.map(item => {
    const isCall = item.type === 'call';
    const dirLabel = (item.direction ?? '').includes('INBOUND') ? 'Inbound' : 'Outbound';
    const headline = isCall
      ? `${dirLabel} call`
      : `Email ${(item.direction ?? '').includes('INCOMING') ? 'received' : 'sent'}`;
    const detail = isCall
      ? [item.durationSec ? `Duration: ${durStr(item.durationSec)}` : '', esc(item.summary)].filter(Boolean).join(' · ')
      : esc(item.summary);
    return `
      <li class="act-item" data-type="${esc(item.type)}">
        <div class="act-icon act-icon--${esc(item.type)}" aria-hidden="true">${isCall ? callIcon() : emailIcon()}</div>
        <div class="act-body">
          <div class="act-headline">${esc(headline)}</div>
          <div class="act-detail">${detail || ''}</div>
        </div>
        <time class="act-time" datetime="${esc(item.createdAt)}">${esc(relativeTime(item.createdAt))}</time>
      </li>`;
  }).join('');
}

async function loadActivity(filter = actFilter) {
  try {
    const res = await fetch(`/api/activity?filter=${filter}`);
    if (!res.ok) throw new Error(`${res.status}`);
    renderActivity(await res.json());
  } catch {
    actList.innerHTML = '<li class="act-item" style="color:var(--kc-danger);padding:16px 20px;font-size:.875rem">Could not load activity.</li>';
  }
}

actTabs.forEach(tab => {
  tab.addEventListener('click', () => {
    const filter = tab.dataset.filter!;
    actFilter = filter;
    actTabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-pressed', 'false'); });
    tab.classList.add('active');
    tab.setAttribute('aria-pressed', 'true');
    announce(`Showing: ${filter === 'all' ? 'All activity' : tab.textContent + ' only'}`);
    loadActivity(filter);
  });
});

// ── Boot — load all three sections in parallel ───────────────────────────────
Promise.all([loadConnections(), loadReminders(), loadActivity()]);
</script>
