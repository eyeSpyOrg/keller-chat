---
/**
 * Hero.astro — standardized page hero.
 *
 * Layout: copy (eyebrow → heading → body → CTAs) always LEFT,
 * image always RIGHT when provided. When bgImage is set, a full-bleed
 * background photo is used instead; content runs full-width over a dark overlay.
 *
 * Variants:
 *   light  — white background (default)
 *   dark   — Shadow Black background, white text
 *   brand  — Original Orange background, Shadow Black text
 *   plain  — transparent, inherits parent bg
 *   teal   — Peach (legacy alias; existing pages keep this)
 *   gold   — Warm Cream (legacy alias)
 *
 * Usage:
 *   <Hero
 *     eyebrow="Eye Spy Foundation"
 *     heading="Navigate. Discover. Find. Connect."
 *     body="We help the blind and low vision community..."
 *     primaryCta={{ label: 'Donate', href: '/support/' }}
 *     secondaryCta={{ label: 'Learn More', href: '/about/' }}
 *     imageSrc="/images/community.jpg"
 *     imageAlt="Community members at an Eye Spy Social event"
 *     variant="light"
 *   />
 *
 *   <!-- Or pass an ImagePlaceholder / custom media via slot -->
 *   <Hero heading="...">
 *     <ImagePlaceholder slot="image" label="[Hero photo]" ratio="3 / 2" />
 *   </Hero>
 *
 *   <!-- Background image hero -->
 *   <Hero
 *     heading="Navigate. Discover. Find. Connect."
 *     bgImage="/images/hero-bg.jpg"
 *     primaryCta={{ label: 'Get Started', href: '/programs/' }}
 *   />
 */

import { uniqueId } from '../utils/uniqueId';

interface Cta { label: string; href: string }
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  imageSrc?: string;
  imageAlt?: string;
  bgImage?: string;
  variant?: 'light' | 'dark' | 'brand' | 'plain' | 'teal' | 'gold';
  headingLevel?: 'h1' | 'h2';
}
const {
  eyebrow,
  heading,
  body,
  primaryCta,
  secondaryCta,
  imageSrc,
  imageAlt = '',
  bgImage,
  variant = 'light',
  headingLevel = 'h1',
} = Astro.props;

const H = headingLevel;
const hasImage = imageSrc || Astro.slots.has('image');
const isDark = variant === 'dark' || !!bgImage;
const isBrand = variant === 'brand';

const primaryBtnClass = isDark
  ? 'btn--onDark'
  : isBrand
  ? 'btn--onBrand'
  : 'btn--primary';
const secondaryBtnClass = isDark || isBrand ? 'btn--onDark' : 'btn--secondary';

const sectionClass = bgImage
  ? 'band band--tight hero-section hero-section--bg'
  : `band band--${variant} band--tight hero-section`;

const headingId = uniqueId('hero-heading');
---

<section
  class={sectionClass}
  aria-labelledby={headingId}
>
  {bgImage && (
    <img class="hero-section__bg-img" src={bgImage} alt="" fetchpriority="high" decoding="async" />
  )}
  <div class={`container${hasImage && !bgImage ? ' hero-section__grid' : ''}`}>
    <div class="hero-section__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <H id={headingId} class="hero-section__heading">{heading}</H>
      {body && <p class="lead">{body}</p>}
      {(primaryCta || secondaryCta) && (
        <div class="hero-section__ctas">
          {primaryCta && (
            <a class={`btn btn--lg ${primaryBtnClass}`} href={primaryCta.href}>
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a class={`btn btn--lg ${secondaryBtnClass}`} href={secondaryCta.href}>
              {secondaryCta.label}
            </a>
          )}
        </div>
      )}
    </div>
    {hasImage && !bgImage && (
      <div class="hero-section__media">
        {imageSrc
          ? <img src={imageSrc} alt={imageAlt} width="960" height="640" fetchpriority="high" decoding="async" />
          : <slot name="image" />
        }
      </div>
    )}
  </div>
</section>

<style>
  /* Copy column */
  .hero-section__copy { display: flex; flex-direction: column; gap: var(--space-s); }
  .hero-section__heading { margin: 0; }
  .hero-section .lead { font-size: var(--step-1); }
  .hero-section__ctas { display: flex; gap: var(--space-s); flex-wrap: wrap; margin-top: var(--space-xs); }

  /* Two-column layout: copy left, image right */
  .hero-section__grid { display: grid; gap: var(--space-m); align-items: center; }
  @media (min-width: 52rem) {
    .hero-section__grid { grid-template-columns: 1.15fr 0.85fr; gap: var(--space-l); }
  }
  .hero-section__media { border-radius: var(--radius); overflow: hidden; }
  .hero-section__media img { width: 100%; height: auto; display: block; aspect-ratio: 3 / 2; object-fit: cover; }

  /* New named-variant backgrounds */
  .band--light { background-color: var(--color-bg); }
  .band--brand {
    background-color: var(--color-brand);
    color: var(--color-text);
  }
  .band--brand h1,
  .band--brand h2,
  .band--brand h3 { color: var(--color-text); }
  .band--brand .eyebrow { color: var(--color-dark-2); }
  .band--brand .lead { color: var(--color-dark-2); opacity: 0.85; }
  .band--plain { background-color: transparent; }

  /* Background-image hero */
  .hero-section--bg {
    position: relative;
    background-color: var(--color-dark);
    color: #ffffff;
    isolation: isolate;
  }
  .hero-section__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero-section--bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(17,17,17,0.65);
    z-index: -1;
  }
  .hero-section--bg > .container { position: relative; z-index: 1; }
  .hero-section--bg h1,
  .hero-section--bg h2,
  .hero-section--bg .lead { color: #ffffff; }
  .hero-section--bg .eyebrow { color: var(--color-gold-highlight); }

  /* High contrast overrides */
  html[data-a11y-contrast='high'] .band--brand { background-color: var(--color-bg); color: var(--color-text); }
  html[data-a11y-contrast='high'] .hero-section__bg-img { display: none; }
  html[data-a11y-contrast='high'] .hero-section--bg::before { display: none; }
</style>
