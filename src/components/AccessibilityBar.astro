---
/**
 * AccessibilityBar.astro — top-of-page horizontal accessibility toolbar
 * Persistent strip (not a disclosure widget) for immediate access.
 * Eye Spy design system tokens. WCAG 2.2 AA.
 *
 * Controls:
 *   Text size  ·  High contrast  ·  Text spacing  ·  Reduce motion
 *   Underline links  ·  Dyslexia font  ·  Reset
 *
 * Prefs persist in localStorage and are applied pre-paint by the
 * inline script in BaseLayout <head>.
 */
---

<div class="a11y-bar" role="region" aria-label="Accessibility preferences">
  <div class="a11y-bar__inner">

    <span class="a11y-bar__label" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm9 7h-6v13h-2v-6h-2v6H9V9H3V7h18v2Z"/>
      </svg>
      Accessibility
    </span>

    <div class="a11y-bar__sep" aria-hidden="true"></div>

    <!-- Text size — radio-style group -->
    <div class="a11y-bar__group" role="group" aria-label="Text size">
      <button type="button"
        class="a11y-bar__btn a11y-bar__size-s"
        data-a11y-set="fontsize" data-value="default"
        aria-pressed="true"
        aria-label="Default text size">A</button>
      <button type="button"
        class="a11y-bar__btn a11y-bar__size-m"
        data-a11y-set="fontsize" data-value="lg"
        aria-pressed="false"
        aria-label="Large text size">A</button>
      <button type="button"
        class="a11y-bar__btn a11y-bar__size-l"
        data-a11y-set="fontsize" data-value="xl"
        aria-pressed="false"
        aria-label="Extra large text size">A</button>
    </div>

    <div class="a11y-bar__sep" aria-hidden="true"></div>

    <!-- Display toggles -->
    <div class="a11y-bar__group" role="group" aria-label="Display options">
      <button type="button" class="a11y-bar__btn"
        data-a11y-flag="contrast" data-on="high"
        aria-pressed="false">High Contrast</button>
      <button type="button" class="a11y-bar__btn"
        data-a11y-flag="spacing" data-on="on"
        aria-pressed="false">Spacing</button>
      <button type="button" class="a11y-bar__btn"
        data-a11y-flag="motion" data-on="off"
        aria-pressed="false">Reduce Motion</button>
      <button type="button" class="a11y-bar__btn a11y-bar__btn--hide-xs"
        data-a11y-flag="links" data-on="underline"
        aria-pressed="false">Underline Links</button>
      <button type="button" class="a11y-bar__btn a11y-bar__btn--hide-xs"
        data-a11y-flag="dyslexia" data-on="on"
        aria-pressed="false">Dyslexia Font</button>
    </div>

    <div class="a11y-bar__spacer" aria-hidden="true"></div>

    <button type="button" class="a11y-bar__btn a11y-bar__reset" data-a11y-reset>
      Reset
    </button>

    <div class="a11y-bar__sep" aria-hidden="true"></div>

    <!-- Light / Dark theme toggle -->
    <button type="button" class="a11y-bar__btn a11y-bar__theme-btn" id="a11y-theme-btn"
      aria-label="Switch to light mode">
      <svg id="a11y-icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1"  x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg id="a11y-icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <span id="a11y-theme-label">Light</span>
    </button>
  </div>
</div>

<style>
  /* ── A11y bar — Eye Spy token system ─────────────────────── */
  :root {
    --a11y-bar-h: 44px;
  }

  .a11y-bar {
    position: sticky;
    top: 0;
    z-index: 200;
    width: 100%;
    --a11y-bar-bg: #F2F2F2;
    --a11y-bar-text: #222222;
    --a11y-bar-border: #767676;
    --a11y-bar-btn-bg: transparent;
    --a11y-bar-btn-hover: rgba(34,34,34,.08);
    --a11y-bar-btn-active-bg: #933001;
    --a11y-bar-btn-active-text: #ffffff;
    --a11y-bar-focus: #5E7AC3;
    background: var(--a11y-bar-bg);
    border-bottom: 1px solid var(--a11y-bar-border);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .a11y-bar {
      --a11y-bar-bg: #1a1a1a;
      --a11y-bar-text: #F2F2F2;
      --a11y-bar-border: #444444;
      --a11y-bar-btn-hover: rgba(242,242,242,.10);
    }
  }
  :root[data-theme="dark"] .a11y-bar {
    --a11y-bar-bg: #1a1a1a;
    --a11y-bar-text: #F2F2F2;
    --a11y-bar-border: #444444;
    --a11y-bar-btn-hover: rgba(242,242,242,.10);
  }
  html[data-a11y-contrast="high"] .a11y-bar {
    --a11y-bar-bg: #000000;
    --a11y-bar-text: #ffffff;
    --a11y-bar-border: #ffffff;
    --a11y-bar-btn-active-bg: #ffff00;
    --a11y-bar-btn-active-text: #000000;
  }

  .a11y-bar__inner {
    display: flex;
    align-items: center;
    gap: 4px;
    height: var(--a11y-bar-h);
    padding-inline: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    color: var(--a11y-bar-text);
  }
  .a11y-bar__inner::-webkit-scrollbar { display: none; }

  .a11y-bar__label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'Poppins', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--a11y-bar-text);
    padding-inline-end: 4px;
    flex-shrink: 0;
  }

  .a11y-bar__sep {
    width: 1px;
    height: 20px;
    background: var(--a11y-bar-border);
    flex-shrink: 0;
    margin-inline: 4px;
    opacity: 0.6;
  }

  .a11y-bar__group {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }

  .a11y-bar__spacer { flex: 1; min-width: 0.25rem; }

  .a11y-bar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    min-width: 32px;
    padding-inline: 10px;
    background: var(--a11y-bar-btn-bg);
    color: var(--a11y-bar-text);
    border: 2px solid transparent;
    border-radius: 6px;
    font-family: 'Open Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.12s, color 0.12s, border-color 0.12s;
    /* Ensure 44px tall touch target via padding compensation */
    padding-block: 6px;
    touch-action: manipulation;
  }

  /* Text-size buttons scale the letter */
  .a11y-bar__size-s { font-size: 0.75rem; }
  .a11y-bar__size-m { font-size: 0.9375rem; }
  .a11y-bar__size-l { font-size: 1.125rem; line-height: 1; }

  .a11y-bar__btn:hover {
    background: var(--a11y-bar-btn-hover);
  }
  .a11y-bar__btn:focus-visible {
    outline: 3px solid var(--a11y-bar-focus);
    outline-offset: 2px;
  }
  .a11y-bar__btn[aria-pressed="true"] {
    background: var(--a11y-bar-btn-active-bg);
    color: var(--a11y-bar-btn-active-text);
    border-color: var(--a11y-bar-btn-active-bg);
  }
  html[data-a11y-contrast="high"] .a11y-bar__btn[aria-pressed="true"] {
    color: #000000;
  }
  .a11y-bar__reset {
    color: var(--a11y-bar-text);
    opacity: 0.7;
    font-size: 0.8125rem;
  }
  .a11y-bar__reset:hover { opacity: 1; }

  /* Hide less-critical buttons on very small screens */
  @media (max-width: 600px) {
    .a11y-bar__btn--hide-xs { display: none; }
    .a11y-bar__label span:not(svg) { display: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const storageKey = (k: string) => `a11y-pref-${k}`;

  function apply(key: string, value: string | null) {
    if (value && value !== 'default') {
      root.setAttribute(`data-a11y-${key}`, value);
      try { localStorage.setItem(storageKey(key), value); } catch {}
    } else {
      root.removeAttribute(`data-a11y-${key}`);
      try { localStorage.removeItem(storageKey(key)); } catch {}
    }
    syncButtons();
  }

  function syncButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-a11y-set="fontsize"]').forEach((btn) => {
      const current = root.getAttribute('data-a11y-fontsize') ?? 'default';
      btn.setAttribute('aria-pressed', String(btn.dataset.value === current));
    });
    document.querySelectorAll<HTMLButtonElement>('[data-a11y-flag]').forEach((btn) => {
      const key = btn.dataset.a11yFlag!;
      btn.setAttribute('aria-pressed', String(root.hasAttribute(`data-a11y-${key}`)));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-a11y-set="fontsize"]').forEach((btn) => {
    btn.addEventListener('click', () => apply('fontsize', btn.dataset.value ?? 'default'));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-a11y-flag]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.a11yFlag!;
      const isOn = root.hasAttribute(`data-a11y-${key}`);
      apply(key, isOn ? null : btn.dataset.on!);
    });
  });
  document.querySelector('[data-a11y-reset]')?.addEventListener('click', () => {
    ['fontsize','contrast','spacing','motion','links','dyslexia'].forEach(k => apply(k, null));
  });

  syncButtons();

  /* ── Theme toggle ───────────────────────────────────────────── */
  const themeBtn     = document.getElementById('a11y-theme-btn');
  const themeLabelEl = document.getElementById('a11y-theme-label');
  const iconSunEl    = document.getElementById('a11y-icon-sun');
  const iconMoonEl   = document.getElementById('a11y-icon-moon');

  let darkMode = root.getAttribute('data-theme') !== 'light';

  function applyTheme() {
    root.setAttribute('data-theme', darkMode ? 'dark' : 'light');
    if (iconSunEl)    iconSunEl.hidden  = !darkMode;
    if (iconMoonEl)   iconMoonEl.hidden =  darkMode;
    if (themeLabelEl) themeLabelEl.textContent = darkMode ? 'Light' : 'Dark';
    if (themeBtn)     themeBtn.setAttribute('aria-label', darkMode ? 'Switch to light mode' : 'Switch to dark mode');
    try { localStorage.setItem('kc-theme', darkMode ? 'dark' : 'light'); } catch {}
    const srStatus = document.getElementById('sr-status');
    if (srStatus) {
      srStatus.textContent = '';
      requestAnimationFrame(() => { srStatus.textContent = darkMode ? 'Dark mode active' : 'Light mode active'; });
    }
  }

  if (themeBtn) {
    applyTheme();
    themeBtn.addEventListener('click', () => { darkMode = !darkMode; applyTheme(); });
  }
</script>
