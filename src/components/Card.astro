---
/**
 * Card.astro — versatile content card. Supports image, eyebrow,
 * heading, body text, and a CTA link. Works in any grid.
 *
 * Usage:
 *   <Card
 *     imageSrc="/images/program.jpg"
 *     imageAlt="..."
 *     eyebrow="Program"
 *     heading="Navigation Skills Training"
 *     body="Weekly workshops that teach orientation and mobility..."
 *     ctaLabel="Learn more"
 *     ctaHref="/programs/navigation/"
 *   />
 */

interface Props {
  imageSrc?: string;
  imageAlt?: string;
  eyebrow?: string;
  heading: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  accent?: boolean;
  headingLevel?: 'h2' | 'h3' | 'h4';
}
const {
  imageSrc,
  imageAlt = '',
  eyebrow,
  heading,
  body,
  ctaLabel,
  ctaHref,
  accent = false,
  headingLevel = 'h3',
} = Astro.props;
const H = headingLevel;
---

<article class={`card${accent ? ' card--accent' : ''}${ctaHref ? ' card--link' : ''} stack`}>
  {imageSrc && (
    <div class="card__img-wrap">
      <img
        src={imageSrc}
        alt={imageAlt}
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
        class="card__img"
      />
    </div>
  )}
  <div class="card__body">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <H class="card__heading">{heading}</H>
    {body && <p class="card__text">{body}</p>}
  </div>
  {ctaLabel && ctaHref && (
    <p class="card__cta">
      <a href={ctaHref} class="card__link">{ctaLabel}</a>
    </p>
  )}
</article>

<style>
  .card { background: var(--color-surface); border: 2px solid var(--color-border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; box-shadow: var(--shadow-sm); }
  .card--accent { border-color: var(--color-accent); }
  .card__img-wrap { aspect-ratio: 16 / 9; overflow: hidden; flex-shrink: 0; }
  .card__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card__body { padding: var(--space-m); flex: 1; display: flex; flex-direction: column; gap: var(--space-xs); }
  .card__heading { margin: 0; font-size: var(--step-1); }
  .card__text { margin: 0; color: var(--color-text-muted); flex: 1; }
  .card__cta { padding: 0 var(--space-m) var(--space-m); margin: 0; }
  .card__link { font-weight: 700; color: var(--color-accent); text-decoration: underline; }
  .card__link:hover { color: var(--color-accent-hover); }
  .card--link:hover { box-shadow: var(--shadow); }
</style>
