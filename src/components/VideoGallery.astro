---
/**
 * VideoGallery.astro — responsive grid of lazy-loaded YouTube embeds.
 * Columns: 1 (mobile) → 2 (tablet) → 3 (desktop).
 *
 * Usage:
 *   <VideoGallery
 *     heading="Impact in Action"
 *     videos={[
 *       { videoId: 'abc123', title: '2024 Year in Review', description: '...' },
 *     ]}
 *   />
 */

import YouTubeEmbed from './YouTubeEmbed.astro';

interface Video {
  videoId: string;
  title: string;
  description?: string;
}
interface Props {
  videos: Video[];
  heading?: string;
  eyebrow?: string;
  columns?: 2 | 3 | 4;
}
const { videos, heading, eyebrow, columns = 3 } = Astro.props;
---

<section class="video-gallery" aria-labelledby={heading ? 'vg-heading' : undefined}>
  {(eyebrow || heading) && (
    <div class="section-head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {heading && <h2 id="vg-heading">{heading}</h2>}
    </div>
  )}
  {videos.length > 0 ? (
    <ul class={`vg-grid vg-grid--${columns}`}>
      {videos.map((v) => (
        <li>
          <YouTubeEmbed videoId={v.videoId} title={v.title} description={v.description} />
        </li>
      ))}
    </ul>
  ) : (
    <p class="vg-empty">Videos coming soon.</p>
  )}
</section>

<style>
  .section-head { margin-bottom: var(--space-m); }
  .vg-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .vg-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) {
    .vg-grid--3 { grid-template-columns: repeat(3, 1fr); }
    .vg-grid--4 { grid-template-columns: repeat(4, 1fr); }
  }
  .vg-empty { color: var(--color-text-muted); font-style: italic; }
</style>
